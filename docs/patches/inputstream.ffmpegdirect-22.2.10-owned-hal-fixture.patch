+void HalDevice::RequestStop()noexcept {
+  stop_requested_.store(1);
+  if(auto* core=published_core_.load())core->Retire(Reason::cancelled);
+}
+CleanupResult HalDevice::Cleanup(uint64_t deadline)noexcept {
+  if(!state_||!state_->claimed)return CleanupResult::clean;
+  auto s=state_;s->core.Retire(Reason::cleanup);
+  CleanupResult result=CleanupResult::failed;
+  if(s->cleanup.Result(result))return ReportCleanup(*s,result);
+  if(!s->pinned) {
+    // Cancellation can win before pinning, with no exposed context. Keep that
+    // entire cleanup synchronous so no unpinned worker can outlive the caller.
+    if(s->cleanup.Choose(CleanupResult::clean)){s->keep_alive.reset();ModuleGate().Release();}
+    s->cleanup.Result(result);return ReportCleanup(*s,result);
