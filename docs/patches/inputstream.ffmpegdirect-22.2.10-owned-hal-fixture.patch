+void InputStreamFFmpegDirect::RunOwnedHal()
+{
+  auto& core=m_ownedHalState->Core();
+  owned_hal::EffectiveControl effective{};
+  auto decode=[](const std::string& hex,uint64_t* limbs,size_t count){
+    for(size_t i=0;i<count;++i)limbs[i]=std::stoull(hex.substr(i*16,16),nullptr,16);
+  };
+  // Original wire identities were checked before Open; zero-valued limbs stay valid.
+  decode(m_ownedClockNonce,effective.binding.nonce.data(),2);
+  decode(m_ownedClockIncarnation,effective.binding.incarnation.data(),2);
+  decode(m_ownedClockTimeline,effective.binding.timeline.data(),4);
+  effective.device_generation=effective.stream_generation=1;
+  owned_clock::Gain gain{};
+  owned_hal::ResumeGrant resumeGrant;
+  owned_hal::AppliedControlView appliedView;
