+DEMUX_PACKET* InputStreamFFmpegDirect::MakeOwnedVideoPacket()
+{
+  owned_stall::Span callSpan(m_ownedStalls,owned_stall::HostPacketCall,MachAbsoluteNowNs,true);
+  if(!m_ownedHlsFixture || !m_ownedRendererActive.load())return nullptr;
+  DEMUX_PACKET* packet=nullptr;
+  bool emitted=false,ended=false,terminal=false;
+  owned_video::Snapshot snapshot;
+  {
+    const uint64_t waitStart=MachAbsoluteNowNs();
+    std::lock_guard<std::mutex> lock(m_ownedMutex);
+    const uint64_t now=MachAbsoluteNowNs();
+    m_ownedStalls.Record(owned_stall::HostOwnedWait,waitStart,now);
+    const bool cancel=m_ownedStop.load() || m_ownedSourceStop.load() || m_ownedFailed.load();
+    const bool closedBefore=m_ownedVideoHost.Get().closed;
+    const auto result=m_ownedVideoHost.Next(now,m_ownedAcceptedFrames.load(),cancel);
+    if(result==owned_video::Result::Error)
+    {RevokeOwnedClock("video_host_failure");m_ownedFailed=true;m_ownedSourceStop=true;return nullptr;}
+    if(result==owned_video::Result::End)
+    {ended=true;terminal=!closedBefore;snapshot=m_ownedVideoHost.Get();}
+    else
+    {
+      emitted=result==owned_video::Result::Frame;
+      packet=AllocateDemuxPacketFromInputStreamAPI(emitted ? static_cast<int>(owned_video::Bytes) : 0);
+      double pts=STREAM_NOPTS_VALUE,duration=0;
+      if(!packet || (emitted && !m_ownedVideoHost.Fill(packet->pData,owned_video::Bytes,now,pts,duration)))
+      {
+        if(packet)FreeDemuxPacketFromInputStreamAPI(packet);
+        m_ownedVideoHost.Close(now);RevokeOwnedClock("video_host_failure");
+        m_ownedFailed=true;m_ownedSourceStop=true;return nullptr;
+      }
+      packet->iSize=emitted ? static_cast<int>(owned_video::Bytes) : 0;
+      packet->iStreamId=emitted ? m_ownedAudioStreamId : -1;packet->demuxerId=m_ownedDemuxerId;
+      packet->iGroupId=0;packet->pSideData=nullptr;packet->iSideDataElems=0;
+      packet->pts=pts;packet->dts=pts;packet->duration=duration;
+      packet->dispTime=-1;packet->recoveryPoint=false;packet->cryptoInfo=nullptr;
+      if(emitted)
+      {m_ownedHostNextPts=pts+duration;m_ownedHostPtsValid=true;m_ownedHostTimeMs.store(static_cast<int>(pts/1000.0));}
+    }
+  }
+  if(ended)
+  {
+    if(terminal)
+    {
+    std::ostringstream line;
+    line << "{\"kind\":\"host_control_terminal\",\"host_representation\":";
+    owned_video::WriteJson(line,snapshot);line << '}';WriteOwnedTelemetryLine(line.str());
+    }
+    return nullptr;
+  }
+  if(emitted)
+  {
+    const uint64_t delivered=MachAbsoluteNowNs();
+    const uint64_t previous=m_ownedLastHostPacketNs.exchange(delivered);
+    if(previous)m_ownedStalls.Record(owned_stall::HostPacketInterarrival,previous,delivered);
+  }
+  return packet;
+}
