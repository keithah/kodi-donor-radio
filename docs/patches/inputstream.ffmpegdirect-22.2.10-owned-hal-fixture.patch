+      if(missing){valid=false;continue;}
+      char name[32];std::snprintf(name,sizeof(name),"gain-%06llu.json",static_cast<unsigned long long>(i+1));struct stat st{};
+      if(fstatat(directory,name,&st,AT_SYMLINK_NOFOLLOW)!=0||!File(st)||st.st_size<=0||st.st_size>2048){valid=false;continue;}
