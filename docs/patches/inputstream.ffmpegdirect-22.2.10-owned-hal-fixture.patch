+      c.request_start_ns<=c.request_end_ns&&c.request_end_ns-c.request_start_ns<=50000000&&
+      c.request_end_ns<=c.issue_ns&&c.issue_ns<=c.expiry_ns&&c.request_start_ns<=UINT64_MAX-500000000&&
