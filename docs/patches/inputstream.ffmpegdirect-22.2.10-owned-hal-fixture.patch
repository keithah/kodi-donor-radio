+    ledger=openat(directory,"native.jsonl",O_WRONLY|O_CREAT|O_EXCL|O_APPEND|O_NOFOLLOW|O_CLOEXEC,0600);
+    if(ledger<0 || fchmod(ledger,0600)!=0 || fstat(ledger,&ledgerIdentity)!=0) {Close();return false;}
+    int fd=openat(directory,".native-hello.tmp",O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);
+    if(fd<0) {Close();return false;}
+    const bool helloOk=fchmod(fd,0600)==0 && Write(fd,hello);
+    close(fd);
+    // The immutable handshake becomes visible only when complete and ledger-ready.
+    // RENAME_EXCL preserves collision rejection without a link-count race for readers.
+    if(!helloOk || renameatx_np(directory,".native-hello.tmp",directory,"hello.json",RENAME_EXCL)!=0 ||
+       fstatat(directory,"hello.json",&helloIdentity,AT_SYMLINK_NOFOLLOW)!=0 || !File(helloIdentity)) {
+      Close();return false;
+    }
+    return true;
+  }
+  bool Append(const std::string& line) {
+    struct stat current{};
+    if(ledger<0 || line.size()>16383 || fstatat(directory,"native.jsonl",&current,AT_SYMLINK_NOFOLLOW)!=0 ||
+       !File(current) || current.st_dev!=ledgerIdentity.st_dev || current.st_ino!=ledgerIdentity.st_ino ||
+       current.st_size!=ledgerBytes) return false;
+    if(!Write(ledger,line+"\n")) return false;
+    ledgerBytes+=line.size()+1; return true;
+  }
+  // The result is permanent evidence validity, not permission to use pending.
+  // Even after retirement, pending contains only individually validated exact-next
+  // controls from the original pinned directory. Never discard a safe prefix.
+  bool Poll(unsigned revision,std::vector<std::string>& pending) {
+    pending.clear();
+    struct stat current{};
+    if(directory<0 || lstat(path.c_str(),&current)!=0 || !S_ISDIR(current.st_mode) ||
+       current.st_dev!=identity.st_dev || current.st_ino!=identity.st_ino ||
+       current.st_uid!=geteuid() || (current.st_mode&0777)!=0700 || revision>64)
+      return ownershipIntact=false;
