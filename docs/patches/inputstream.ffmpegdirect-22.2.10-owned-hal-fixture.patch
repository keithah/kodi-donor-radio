+DEMUX_PACKET* InputStreamFFmpegDirect::MakeOwnedPcmPacket(bool probe)
+{
+  owned_stall::Span callSpan(m_ownedStalls,owned_stall::HostPacketCall,MachAbsoluteNowNs,true);
+  // The caller is the existing live host callback. No source data enters this packet.
+  if (!m_ownedHlsFixture || !m_ownedRendererActive.load()) return nullptr;
+  DEMUX_PACKET* packet=nullptr;
+  {
+    const uint64_t waitStart=MachAbsoluteNowNs();
+    std::lock_guard<std::mutex> lock(m_ownedMutex);
+    m_ownedStalls.Record(owned_stall::HostOwnedWait,waitStart,MachAbsoluteNowNs());
+    const bool terminal=m_ownedStop.load() || m_ownedSourceStop.load() ||
+        m_ownedFailed.load() || m_ownedDrained.load();
+    double pts=0,duration=0;
+    if (terminal || m_ownedPcmHost.State().closed)
+    {
+      m_ownedPcmHost.Issue(nullptr,0,probe,true,pts,duration);
+      return nullptr;
+    }
+    packet=AllocateDemuxPacketFromInputStreamAPI(static_cast<int>(owned_pcm::Bytes));
+    const auto result=m_ownedPcmHost.Issue(packet ? packet->pData : nullptr,
+        owned_pcm::Bytes,probe,false,pts,duration);
+    if (result!=owned_pcm::Result::Packet || m_ownedAudioStreamId<0)
+    {
+      if(packet)FreeDemuxPacketFromInputStreamAPI(packet);
+      RevokeOwnedClock("native_failure");m_ownedFailed=true;m_ownedSourceStop=true;
+      Log(LOGLEVEL_ERROR,"OWNED_RENDERER: bounded PCM host packet failed");
+      return nullptr;
+    }
+    packet->iSize=static_cast<int>(owned_pcm::Bytes);
+    packet->iStreamId=m_ownedAudioStreamId;packet->demuxerId=m_ownedDemuxerId;
+    packet->iGroupId=0;packet->pSideData=nullptr;packet->iSideDataElems=0;
+    packet->pts=pts;packet->dts=pts;packet->duration=duration;
+    packet->dispTime=-1;packet->recoveryPoint=false;packet->cryptoInfo=nullptr;
+    if(!probe)
+    {
+      m_ownedHostNextPts=pts+duration;m_ownedHostPtsValid=true;
+      m_ownedHostTimeMs.store(static_cast<int>(pts/1000.0));
+    }
+  }
+  const uint64_t delivered=MachAbsoluteNowNs();
+  const uint64_t previous=m_ownedLastHostPacketNs.exchange(delivered);
+  if(previous)m_ownedStalls.Record(owned_stall::HostPacketInterarrival,previous,delivered);
+  return packet;
+}
