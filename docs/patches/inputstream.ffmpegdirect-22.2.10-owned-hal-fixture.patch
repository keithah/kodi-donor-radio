+#endif
+
+namespace owned_clock {
+// Observes default-device changes for this fixture. Not physical-output authentication,
+// and does not detect a same-device, same-format internal Kodi sink restart.
+class OutputGuard {
+public:
+  OutputGuard() : signal(std::make_shared<Signal>()) {}
+  ~OutputGuard() { Close(); }
+  uint64_t Generation() const { return signal->generation.load(); }
+  bool Valid() const { return armed && !signal->revoked.load(); }
+  void Revoke() { signal->revoked.store(true); signal->generation.fetch_add(1); }
+  bool Start(kodi::audioengine::CAEStream& stream) {
+    if(attempted)return Valid();
+    attempted=true;
+#if defined(__APPLE__)
+    const auto before=Generation();
+    if(!Listen(kAudioObjectSystemObject,kAudioHardwarePropertyDefaultOutputDevice,kAudioObjectPropertyScopeGlobal) ||
+       !Listen(kAudioObjectSystemObject,kAudioHardwarePropertyDevices,kAudioObjectPropertyScopeGlobal) ||
+       !Read(kAudioObjectSystemObject,kAudioHardwarePropertyDefaultOutputDevice,kAudioObjectPropertyScopeGlobal,device) ||
+       device==kAudioObjectUnknown ||
+       !Listen(device,kAudioDevicePropertyDeviceIsAlive,kAudioObjectPropertyScopeGlobal) ||
+       !Listen(device,kAudioDevicePropertyNominalSampleRate,kAudioObjectPropertyScopeGlobal) ||
+       !Listen(device,kAudioDevicePropertyStreamConfiguration,kAudioDevicePropertyScopeOutput)) {
+      Revoke();Close();return false;
+    }
+    std::string one,two;
+    if(!Fingerprint(stream,one) || !Fingerprint(stream,two) || one!=two || before!=Generation() || signal->revoked.load()) {
+      Revoke();Close();return false;
+    }
+    fingerprint=one;armed=true;return true;
+#else
+    Revoke();return false;
+#endif
+  }
+  bool Check(kodi::audioengine::CAEStream& stream) {
+#if defined(__APPLE__)
+    if(!Valid())return false;
+    const auto before=Generation(); std::string now;
+    if(!Fingerprint(stream,now) || now!=fingerprint || before!=Generation())Revoke();
+    return Valid();
+#else
+    return false;
+#endif
+  }
+  void Close() {
+    armed=false;
+#if defined(__APPLE__)
+    for(auto& registration:listeners) {
+      AudioObjectRemovePropertyListenerBlock(registration.object,&registration.address,queue,registration.block);
+      Block_release(registration.block);
+    }
+    listeners.clear();
+#endif
+  }
+private:
+  struct Signal { std::atomic<uint64_t> generation{1};std::atomic<bool> revoked{false}; };
+  std::shared_ptr<Signal> signal;
+  bool attempted{false},armed{false};
+  std::string fingerprint;
+#if defined(__APPLE__)
+  struct Registration { AudioObjectID object; AudioObjectPropertyAddress address; AudioObjectPropertyListenerBlock block; };
+  std::vector<Registration> listeners;
+  dispatch_queue_t queue=dispatch_get_global_queue(QOS_CLASS_DEFAULT,0);
+  AudioDeviceID device{kAudioObjectUnknown};
+  bool Listen(AudioObjectID object,AudioObjectPropertySelector selector,AudioObjectPropertyScope scope) {
+    const auto shared=signal;
+    AudioObjectPropertyListenerBlock block=Block_copy(^(UInt32,const AudioObjectPropertyAddress*) {
+      shared->revoked.store(true); shared->generation.fetch_add(1);
+    });
+    AudioObjectPropertyAddress address{selector,scope,kAudioObjectPropertyElementMain};
+    if(AudioObjectAddPropertyListenerBlock(object,&address,queue,block)!=noErr) {Block_release(block);return false;}
+    listeners.push_back({object,address,block});return true;
+  }
+  template<class T> static bool Read(AudioObjectID object,AudioObjectPropertySelector selector,
+                                    AudioObjectPropertyScope scope,T& value) {
+    AudioObjectPropertyAddress address{selector,scope,kAudioObjectPropertyElementMain};UInt32 size=sizeof(T);
+    return AudioObjectGetPropertyData(object,&address,0,nullptr,&size,&value)==noErr && size==sizeof(T);
+  }
+  bool Fingerprint(kodi::audioengine::CAEStream& stream,std::string& result) {
+    AudioDeviceID current=kAudioObjectUnknown;UInt32 alive=0;Float64 rate=0;
+    if(!Read(kAudioObjectSystemObject,kAudioHardwarePropertyDefaultOutputDevice,kAudioObjectPropertyScopeGlobal,current) ||
+       current!=device || !Read(device,kAudioDevicePropertyDeviceIsAlive,kAudioObjectPropertyScopeGlobal,alive) || alive!=1 ||
+       !Read(device,kAudioDevicePropertyNominalSampleRate,kAudioObjectPropertyScopeGlobal,rate) || rate!=48000.0) return false;
+    AudioObjectPropertyAddress address{kAudioDevicePropertyStreamConfiguration,kAudioDevicePropertyScopeOutput,kAudioObjectPropertyElementMain};
+    UInt32 size=0;
+    if(AudioObjectGetPropertyDataSize(device,&address,0,nullptr,&size)!=noErr || size<sizeof(AudioBufferList) || size>65536) return false;
+    std::vector<uint8_t> bytes(size);
+    if(AudioObjectGetPropertyData(device,&address,0,nullptr,&size,bytes.data())!=noErr || size<sizeof(AudioBufferList) || size>bytes.size())return false;
+    const auto* buffers=reinterpret_cast<const AudioBufferList*>(bytes.data());
+    if(buffers->mNumberBuffers==0 || buffers->mNumberBuffers>(size-offsetof(AudioBufferList,mBuffers))/sizeof(AudioBuffer))return false;
