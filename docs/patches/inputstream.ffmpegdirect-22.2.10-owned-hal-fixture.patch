+  DEMUX_PACKET* packet = AllocateDemuxPacketFromInputStreamAPI(
+      static_cast<int>(silenceFrame.size()));
+  if (!packet)
+  {
+    RevokeOwnedClock("native_failure");
+    m_ownedFailed = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: could not allocate silent AAC tail packet");
+    return nullptr;
+  }
+  std::memcpy(packet->pData, silenceFrame.data(), silenceFrame.size());
+  packet->iSize = static_cast<int>(silenceFrame.size());
+  packet->iStreamId = streamId;
+  packet->demuxerId = demuxerId;
+  packet->iGroupId = 0;
+  packet->pSideData = nullptr;
+  packet->iSideDataElems = 0;
+  packet->pts = pts;
+  packet->dts = pts;
+  packet->duration = m_ownedFrameDuration;
+  packet->dispTime = -1;
+  packet->recoveryPoint = false;
+  packet->cryptoInfo = nullptr;
+  if (m_ownedHlsFixture)
+  {
+    const uint64_t delivered = MachAbsoluteNowNs();
+    const uint64_t previous = m_ownedLastHostPacketNs.exchange(delivered);
+    if (previous != 0)
+      m_ownedStalls.Record(owned_stall::HostPacketInterarrival, previous, delivered);
