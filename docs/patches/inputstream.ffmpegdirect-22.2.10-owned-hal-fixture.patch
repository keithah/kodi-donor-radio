+          <<m_ownedClockNonce<<"\",\"incarnation\":\""<<m_ownedClockIncarnation<<"\",\"timeline_sha256\":\""<<m_ownedClockTimeline
+          <<"\",\"hal_contract_version\":1,\"device_generation\":"<<segment.device_generation
+          <<",\"request_start_ns\":"<<applied.request_start_ns<<",\"request_end_ns\":"<<applied.request_end_ns<<",\"issue_ns\":"<<applied.issue_ns
+          <<",\"expiry_ns\":"<<applied.expiry_ns<<",\"in_flight_generation\":"<<segment.in_flight_generation
+          <<",\"playback_revision\":"<<segment.playback_revision<<",\"playback_epoch\":"<<segment.playback_epoch
+          <<",\"publication_sequence\":"<<segment.publication_sequence<<",\"applied_intent\":"<<segment.applied_intent
+          <<",\"native_gate\":"<<segment.native_gate<<",\"authorized_native_epoch\":"<<segment.authorized_native_epoch
+          <<",\"resume_playback_revision\":"<<segment.resume_playback_revision<<",\"resume_granted\":"<<(segment.resume_granted?"true":"false")
+          <<",\"gain_revision\":"<<segment.gain_revision
+          <<",\"gain_epoch\":"<<segment.gain_epoch<<",\"volume\":"<<applied.volume<<",\"muted\":"<<(segment.muted?"true":"false")
+          <<",\"applied_gain\":"<<segment.applied_gain<<",\"output_host_ns\":"<<segment.output_host_ns
+          <<",\"source_start\":"<<segment.source_start<<",\"segment_sequence\":"<<segment.sequence<<"}";
+        if(!WriteOwnedTelemetryLine(ack.str())){RevokeOwnedClock("hal_gain_ack_ledger");break;}
