+  }
+  bool Finish()noexcept {
+    if(!Ready()||end_.load(std::memory_order_relaxed)!=UINT64_MAX)return false;
+    end_.store(write_.load(std::memory_order_relaxed),std::memory_order_release);return true;
+  }
+  uint32_t Available()const noexcept {
