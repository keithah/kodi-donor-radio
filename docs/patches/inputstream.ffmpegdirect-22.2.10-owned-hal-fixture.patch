+DEMUX_PACKET* InputStreamFFmpegDirect::MakeOwnedSilentPacket()
+{
+  if (m_ownedHlsFixture) return m_ownedPlayerMode.VideoControl() ? MakeOwnedVideoPacket() : MakeOwnedPcmPacket();
+  owned_stall::Span callSpan(m_ownedStalls, owned_stall::HostPacketCall, MachAbsoluteNowNs, m_ownedHlsFixture);
+  std::vector<uint8_t> silenceFrame;
+  double pts = 0.0;
+  int streamId = -1;
+  int64_t demuxerId = 0;
+  const bool hlsHostTimeline = m_ownedHlsFixture;
+  constexpr size_t maxSyntheticFrames = (64 * 48000) / 1024;
+  {
+    const uint64_t waitStart = m_ownedHlsFixture ? MachAbsoluteNowNs() : 0;
+    std::lock_guard<std::mutex> lock(m_ownedMutex);
+    if (m_ownedHlsFixture)
+      m_ownedStalls.Record(owned_stall::HostOwnedWait, waitStart, MachAbsoluteNowNs());
+    const std::vector<uint8_t>& selectedSilenceFrame =
+        m_ownedInputFormatKnown && !m_ownedInputUsesAdts ? m_silenceRawAacFrame
+                                                         : m_silenceAdtsFrame;
+    if (!m_ownedRendererActive.load() || m_ownedDrained.load())
+      return nullptr;
+    const double nextPts = hlsHostTimeline ? m_ownedHostNextPts : m_ownedNextPts;
+    const bool ptsValid = hlsHostTimeline ? m_ownedHostPtsValid : m_ownedPtsValid;
+    if (!ptsValid || !std::isfinite(nextPts) ||
+        (!hlsHostTimeline && m_ownedSyntheticFrames >= maxSyntheticFrames) ||
+        m_ownedSyntheticFrames == std::numeric_limits<size_t>::max() ||
+        m_ownedAudioStreamId < 0 || selectedSilenceFrame.empty())
+    {
+      RevokeOwnedClock("native_failure");
+      m_ownedFailed = true;
+      Log(LOGLEVEL_ERROR,
+          "OWNED_RENDERER: cannot maintain a bounded silent AAC timeline; aborting lab playback");
+      return nullptr;
+    }
+
+    silenceFrame = selectedSilenceFrame;
+    pts = nextPts;
+    streamId = m_ownedAudioStreamId;
+    demuxerId = m_ownedDemuxerId;
+    if (hlsHostTimeline)
+    {
+      if (m_ownedHostOutputFrames == std::numeric_limits<uint64_t>::max())
+      {
+        RevokeOwnedClock("native_failure");
+        m_ownedFailed = true;
+        Log(LOGLEVEL_ERROR, "OWNED_RENDERER: HLS host frame ledger overflowed");
+        return nullptr;
+      }
+      m_ownedHostNextPts += m_ownedFrameDuration;
+      if (std::isfinite(pts) &&
+          pts >= static_cast<double>(std::numeric_limits<int>::min()) * STREAM_TIME_BASE / 1000.0 &&
+          pts <= static_cast<double>(std::numeric_limits<int>::max()) * STREAM_TIME_BASE / 1000.0)
+        m_ownedHostTimeMs.store(static_cast<int>(pts * 1000.0 / STREAM_TIME_BASE));
+      ++m_ownedHostOutputFrames;
+    }
