+  auto beginIntent=[&]{if(intent==UINT64_MAX)return false;return core.BeginEffectiveIntent(++intent)==owned_hal::Status::ok;};
+  auto terminal=[&](const char* reason,uint64_t end,int cleanup=-1){
+    std::ostringstream out;out<<"{\"kind\":\"hal_terminal\",\"output_backend\":\"hal_callback_v1\",\"nonce\":\""
+      <<m_ownedClockNonce<<"\",\"incarnation\":\""<<m_ownedClockIncarnation<<"\",\"timeline_sha256\":\""
+      <<m_ownedClockTimeline<<"\",\"reason\":\""<<reason<<"\",\"source_end_ns\":"<<end
+      <<",\"hold_until_ns\":"<<(end?end+1000000000ULL:0)<<",\"observed_mach_ns\":"<<MachAbsoluteNowNs()
+      <<",\"native_control_reason\":\""<<(m_ownedClock?m_ownedClock->Reason():"missing")<<"\""
+      <<",\"core_failure\":"<<static_cast<uint64_t>(core.Failure())<<",\"failed\":"<<(m_ownedFailed.load()?"true":"false")<<",\"cleanup_result\":"<<cleanup
+      <<",\"exposed_context_retained_until_exit\":true,\"quarantined\":"<<(owned_hal::Quarantined()?"true":"false")
+      <<",\"clock_authority\":false,\"beacons_enabled\":false}";WriteOwnedTelemetryLine(out.str());
+  };
