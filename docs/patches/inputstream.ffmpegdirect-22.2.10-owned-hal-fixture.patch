+bool InputStreamFFmpegDirect::DemuxSeekTime(double time, bool backwards, double& startpts)
+{
+  if (m_ownedPlayerMode.Video()) { RevokeOwnedClock("seek"); return false; }
+  if (m_ownedClock)
+  {
+    const auto state = OwnedStartupSeekState();
+    const bool allowed = m_ownedStartupSeekProbe.Time(time, backwards, state);
+    Log(LOGLEVEL_INFO,
+        "OWNED_CLOCK: demux seek time_ms=%.17g backwards=%d accepted=%llu started=%d armed=%d transferred=%d startup_allowed=%d",
+        time, backwards, static_cast<unsigned long long>(state.acceptedFrames),
+        state.playbackStarted, state.decodeArmed, state.sourceTransferred, allowed);
+    if (!allowed) RevokeOwnedClock("seek");
+  }
+  else if (std::abs(time) >= 0.001 || m_ownedPlaybackStarted.load() || m_ownedSourceOwnershipTransferred.load())
+    RevokeOwnedClock("seek");
+  if (m_ownedRendererActive.load() && m_ownedHlsFixture && m_ownedSourceStop.load())
+  {
+    RevokeOwnedClock("native_failure");
+    m_ownedFailed = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: seek after lab cancellation is unsupported; failing closed");
+    return false;
+  }
+  if (m_ownedSourceOwnershipTransferred.load())
+  {
+    RevokeOwnedClock("native_failure");
+    m_ownedFailed = true;
+    m_ownedSourceStop = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: seek after source handoff is unsupported; failing closed");
+    return false;
+  }
+  if (m_ownedRendererActive.load() && OwnedPlaybackStarted())
+  {
+    RevokeOwnedClock("native_failure");
+    m_ownedFailed = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: seek after AVStarted is unsupported; aborting lab qualification");
+    return false;
+  }
+
+  const bool succeeded = m_stream->DemuxSeekTime(time, backwards, startpts);
+  if (!succeeded) RevokeOwnedClock("seek_failed");
+  if (m_ownedRendererActive.load() && succeeded && std::abs(time) < 0.001)
+  {
+    ResetOwnedTimeline();
+    m_ownedDecodeArmed = true;
+    Log(LOGLEVEL_INFO, "OWNED_RENDERER: successful pre-play Seek(0) reset and armed AAC decode");
+  }
+  return succeeded;
