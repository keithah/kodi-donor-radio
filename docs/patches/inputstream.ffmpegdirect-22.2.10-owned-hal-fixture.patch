+bool ParseAacLc48kStereoAdtsFrame(const uint8_t* data,
+                                 size_t remaining,
+                                 size_t& frameLength)
+{
+  if (!data || remaining < 7 || data[0] != 0xff || (data[1] & 0xf6) != 0xf0 ||
+      ((data[2] >> 6) & 0x03) != 1 || ((data[2] >> 2) & 0x0f) != 3 ||
+      (((data[2] & 0x01) << 2) | ((data[3] >> 6) & 0x03)) != 2)
+    return false;
+
+  const size_t headerLength = (data[1] & 0x01) ? 7 : 9;
+  frameLength = ((static_cast<size_t>(data[3] & 0x03) << 11) |
+                 (static_cast<size_t>(data[4]) << 3) | (data[5] >> 5));
+  return remaining >= headerLength && frameLength >= headerLength && frameLength <= remaining;
+}
+
+uint64_t SteadyNowNs()
+{
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                   std::chrono::steady_clock::now().time_since_epoch())
+                                   .count());
+}
+
+uint64_t WallNowNs()
+{
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                   std::chrono::system_clock::now().time_since_epoch())
+                                   .count());
+}
+
+uint64_t MachAbsoluteNowNs()
+{
+#if defined(__APPLE__)
+  static const mach_timebase_info_data_t timebase = [] {
+    mach_timebase_info_data_t value{};
+    mach_timebase_info(&value);
+    return value;
+  }();
+  if (timebase.denom == 0)
+    return 0;
+  const long double nanoseconds = static_cast<long double>(mach_absolute_time()) *
+                                  static_cast<long double>(timebase.numer) /
+                                  static_cast<long double>(timebase.denom);
+  return static_cast<uint64_t>(nanoseconds);
+#else
+  return 0;
+#endif
+}
