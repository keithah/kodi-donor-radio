+    // Even failure to create a cleanup worker must retain live callback state.
+    s->keep_alive=s;
+    try{std::thread(CleanupWorker,s).detach();}
+    catch(...){if(s->cleanup.Choose(CleanupResult::failed))ModuleGate().Quarantine();}
+  }
+  while(!s->cleanup.Result(result)&&now<deadline) {api_.wait_tick();now=api_.now_ns();}
