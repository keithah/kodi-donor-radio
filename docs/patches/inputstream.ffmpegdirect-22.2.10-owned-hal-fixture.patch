+        c.effective_intent<current_.effective_intent||publication<=current_publication_)))return Fail(Reason::invalid_control);
+    const uint64_t end=source.End(); // acquire EOF before acquiring producer's write index
+    const uint32_t available=source.Available();
+    const uint64_t consumed=source.Consumed();
+    const uint64_t final=FinalEndNs();
+    const bool terminal=final&&entry>=final;
+    // One bounded SC native-gate load is the successful block's acquisition.
+    // Publication counters/desired intent cannot invalidate the selected audio.
+    const uint64_t generation=gate_.Load();
+    if(generation&NativeGate::kRetired)return CommitZero(s,i);
+    const uint64_t native_epoch=generation&NativeGate::kEpochMask;
+    const bool granted=!(generation&NativeGate::kPaused)&&c.resume_playback_revision&&c.native_fence==native_epoch;
+    const bool playing=c.playing&&granted;
+    uint32_t count=0;
+    if(c.started&&c.sample_zero_proven&&playing&&!final&&StartupReleased()) {
+      if(available<kFrames&&end==UINT64_MAX)return Fail(Reason::shortfall);
+      count=std::min(available,kFrames);
+    }
+    uint64_t block_end=0,source_end=0;
+    if(!ScheduledEndNs(i.output_ticks,i.timebase_numer,i.timebase_denom,kFrames,block_end)||
+       !ScheduledEndNs(i.output_ticks,i.timebase_numer,i.timebase_denom,count,source_end))return Fail(Reason::timestamp);
+    const bool last=count&&end!=UINT64_MAX&&consumed+count==end;
+    const uint64_t required=last?source_end:(final?final:block_end);
+    if(!terminal&&(c.request_end_ns>entry||c.issue_ns>entry||c.expiry_ns<required))return Fail(Reason::lease);
+    if(count&&!ever_consumed_&&(entry<c.request_start_ns||
+       static_cast<__uint128_t>(i.entry_ticks)*i.timebase_numer>
+         (static_cast<__uint128_t>(c.request_start_ns)+100000000)*i.timebase_denom))return Fail(Reason::lease);
+    current_=c;current_publication_=publication;have_current_=true;
+    // Nothing below may revoke this block or roll back consumed source.
+    s.binding=c.binding;s.sequence=++sequence_;s.in_flight_generation=generation;s.control_acquired=true;
+    s.device_generation=c.device_generation;s.stream_generation=c.stream_generation;
+    s.playback_revision=c.playback_revision;s.playback_epoch=c.playback_epoch;s.gain_revision=c.gain_revision;s.gain_epoch=c.gain_epoch;
+    s.source_start=consumed;s.source_count=count;s.consumed_frames=count;s.copied_frames=count;s.zero_frames=kFrames-count;
+    s.applied_gain=c.supplied_gain;s.muted=c.muted!=0;s.playing=playing;s.terminal=terminal;
+    s.applied=c;s.publication_sequence=publication;s.applied_intent=c.effective_intent;s.desired_intent=DesiredIntent();
+    s.native_gate=generation;s.authorized_native_epoch=c.native_fence;s.resume_playback_revision=c.resume_playback_revision;
+    s.requested_playing=c.playing!=0;s.resume_granted=granted;
+    s.output_sample_time=i.output_sample_time;s.output_flags=i.output_flags;s.now_flags=i.now_flags;
+    s.output_ticks=i.output_ticks;s.now_ticks=i.now_ticks;s.entry_ticks=i.entry_ticks;s.exit_ticks=i.exit_ticks;
+    s.timebase_numer=i.timebase_numer;s.timebase_denom=i.timebase_denom;s.output_host_ns=host;s.source_end_ns=source_end;
+    if(count){source.Copy(i.output,count,c.supplied_gain);ever_consumed_=true;}
+    if(last){final_end_.store(source_end,std::memory_order_release);}
+    // Zero-length EOF is terminal at this scheduled boundary, with no source clock.
+    if(!final&&!count&&end==consumed&&c.started&&c.sample_zero_proven&&playing)final_end_.store(host,std::memory_order_release);
+    if(i.read_exit_ticks)s.exit_ticks=i.read_exit_ticks();
+    evidence.Push(s); // sole producer, reserved Space cannot be taken by anyone else
+    r.sequence=s.sequence;r.consumed_frames=count;r.copied_frames=count;r.zero_frames=kFrames-count;return r;
+  }
+private:
+  CallbackResult CommitZero(HalSegment& s,const CallbackInput& i)noexcept {
+    s.sequence=++sequence_;if(i.read_exit_ticks)s.exit_ticks=i.read_exit_ticks();
+    evidence.Push(s);CallbackResult r{};r.sequence=s.sequence;return r;
+  }
+  CallbackResult Fail(Reason reason)noexcept {Retire(reason);CallbackResult r{};r.reason=reason;return r;}
+  ControlMailbox controls_;NativeGate gate_;std::atomic<uint64_t> desired_intent_{1};
+  std::atomic<uint64_t> reason_{0},final_end_{0};
+  std::atomic<bool> startup_released_{true};
+  // Owner-only publication bookkeeping. Render never reads these fields.
+  EffectiveControl last_control_{};bool have_control_=false;
+  // Callback-only state: one HAL IOProc, no parallel Render calls permitted.
+  EffectiveControl current_{};bool have_current_=false;uint64_t current_publication_=0;
+  uint64_t sequence_=0,prior_ticks_=0;double prior_sample_=0;
+  uint32_t numer_=0,denom_=0;bool have_timestamp_=false,ever_consumed_=false;
+};
+}
diff --git a/src/OwnedHalDevice.cpp b/src/OwnedHalDevice.cpp
new file mode 100644
index 0000000..cd4ea56
--- /dev/null
+++ b/src/OwnedHalDevice.cpp
@@ -0,0 +1,239 @@
+#include "OwnedHalDevice.h"
+#include <CoreFoundation/CoreFoundation.h>
+#include <mach/mach_time.h>
+#include <chrono>
+#include <thread>
+#include <new>
+
+extern "C" __attribute__((visibility("default"))) void OwnedHalModuleIdentityV1() {}
+namespace owned_hal {
+namespace {
+constexpr OSStatus kInvalid=-1;
+uint64_t NowTicks()noexcept {return mach_absolute_time();}
+uint64_t NowNs()noexcept {
+  mach_timebase_info_data_t b{};uint64_t result=0;
+  if(mach_timebase_info(&b)!=KERN_SUCCESS||!TicksToNs(mach_absolute_time(),b.numer,b.denom,result))return UINT64_MAX;
+  return result;
+}
+void WaitTick()noexcept {std::this_thread::sleep_for(std::chrono::milliseconds(1));}
+AudioObjectPropertyAddress Address(AudioObjectPropertySelector s,AudioObjectPropertyScope scope=kAudioObjectPropertyScopeGlobal)noexcept {
+  return {s,scope,kAudioObjectPropertyElementMain};
+}
+template<typename T> bool Get(AudioObjectID id,AudioObjectPropertyAddress address,T& value)noexcept {
+  UInt32 bytes=sizeof(T);return AudioObjectGetPropertyData(id,&address,0,nullptr,&bytes,&value)==noErr&&bytes==sizeof(T);
+}
+bool Format(const AudioStreamBasicDescription& f)noexcept {
+  const UInt32 flags=kAudioFormatFlagIsFloat|kAudioFormatFlagIsPacked;
+  return f.mSampleRate==48000&&f.mFormatID==kAudioFormatLinearPCM&&f.mFormatFlags==flags&&
+    f.mBytesPerPacket==8&&f.mFramesPerPacket==1&&f.mBytesPerFrame==8&&f.mChannelsPerFrame==2&&f.mBitsPerChannel==32;
+}
+OSStatus ReadContract(const DeviceContract& c)noexcept {
+  AudioDeviceID current=0;UInt32 alive=0,transport=0,frames=0,channel=0;Float64 rate=0;
+  if(!Get(kAudioObjectSystemObject,Address(kAudioHardwarePropertyDefaultOutputDevice),current)||current!=c.device||
+     !Get(c.device,Address(kAudioDevicePropertyDeviceIsAlive),alive)||alive!=1||
+     !Get(c.device,Address(kAudioDevicePropertyTransportType),transport)||transport!=kAudioDeviceTransportTypeBuiltIn||
+     !Get(c.device,Address(kAudioDevicePropertyNominalSampleRate),rate)||rate!=48000||
+     !Get(c.device,Address(kAudioDevicePropertyBufferFrameSize),frames)||frames!=512)return kInvalid;
+  CFStringRef uid=nullptr;
+  if(!Get(c.device,Address(kAudioDevicePropertyDeviceUID),uid)||!uid)return kInvalid;
+  const bool builtIn=CFEqual(uid,CFSTR("BuiltInSpeakerDevice"));CFRelease(uid);if(!builtIn)return kInvalid;
+  AudioStreamID stream=0;
+  if(!Get(c.device,Address(kAudioDevicePropertyStreams,kAudioDevicePropertyScopeOutput),stream)||stream!=c.stream)return kInvalid;
+  AudioBufferList config{};
+  if(!Get(c.device,Address(kAudioDevicePropertyStreamConfiguration,kAudioDevicePropertyScopeOutput),config)||
+     config.mNumberBuffers!=1||config.mBuffers[0].mNumberChannels!=2||config.mBuffers[0].mDataByteSize!=4096)return kInvalid;
+  AudioStreamBasicDescription physical{},virtualFormat{};
+  if(!Get(c.stream,Address(kAudioStreamPropertyVirtualFormat),virtualFormat)||!Format(virtualFormat)||
+     !Get(c.stream,Address(kAudioStreamPropertyPhysicalFormat),physical)||!Format(physical)||
+     !Get(c.stream,Address(kAudioStreamPropertyStartingChannel),channel)||channel!=1)return kInvalid;
+  return noErr;
+}
+OSStatus Resolve(DeviceContract& c)noexcept {
+  mach_timebase_info_data_t base{};
+  if(mach_timebase_info(&base)!=KERN_SUCCESS||!base.numer||!base.denom||
+     !Get(kAudioObjectSystemObject,Address(kAudioHardwarePropertyDefaultOutputDevice),c.device)||!c.device||
+     !Get(c.device,Address(kAudioDevicePropertyStreams,kAudioDevicePropertyScopeOutput),c.stream)||!c.stream)return kInvalid;
+  c.timebase_numer=base.numer;c.timebase_denom=base.denom;return ReadContract(c);
+}
+AudioObjectID Guard(const DeviceContract& c,uint32_t index,AudioObjectPropertyAddress& address)noexcept {
+  switch(index){
+    case 0:address=Address(kAudioHardwarePropertyDefaultOutputDevice);return kAudioObjectSystemObject;
+    case 1:address=Address(kAudioDevicePropertyDeviceIsAlive);return c.device;
+    case 2:address=Address(kAudioDevicePropertyNominalSampleRate);return c.device;
+    case 3:address=Address(kAudioDevicePropertyStreamConfiguration,kAudioDevicePropertyScopeOutput);return c.device;
+    case 4:address=Address(kAudioDevicePropertyBufferFrameSize);return c.device;
+    case 5:address=Address(kAudioDevicePropertyStreams,kAudioDevicePropertyScopeOutput);return c.device;
+    case 6:address=Address(kAudioStreamPropertyVirtualFormat);return c.stream;
+    case 7:address=Address(kAudioStreamPropertyPhysicalFormat);return c.stream;
+    default:address=Address(kAudioStreamPropertyStartingChannel);return c.stream;
+  }
+}
+OSStatus Add(const DeviceContract& c,uint32_t n,AudioObjectPropertyListenerProc listener,void* ctx)noexcept {
+  AudioObjectPropertyAddress a{};const auto id=Guard(c,n,a);return AudioObjectAddPropertyListener(id,&a,listener,ctx);
+}
+OSStatus Remove(const DeviceContract& c,uint32_t n,AudioObjectPropertyListenerProc listener,void* ctx)noexcept {
+  AudioObjectPropertyAddress a{};const auto id=Guard(c,n,a);return AudioObjectRemovePropertyListener(id,&a,listener,ctx);
+}
+OSStatus Create(AudioDeviceID d,AudioDeviceIOProc cb,void* ctx,AudioDeviceIOProcID* id)noexcept{return AudioDeviceCreateIOProcID(d,cb,ctx,id);}
+OSStatus Start(AudioDeviceID d,AudioDeviceIOProcID id)noexcept{return AudioDeviceStart(d,id);}
+OSStatus Stop(AudioDeviceID d,AudioDeviceIOProcID id)noexcept{return AudioDeviceStop(d,id);}
+OSStatus Destroy(AudioDeviceID d,AudioDeviceIOProcID id)noexcept{return AudioDeviceDestroyIOProcID(d,id);}
+}
+DeviceApi PublicDeviceApi()noexcept {
+  DeviceApi api{};api.pin=PinOwnModule;api.now_ns=NowNs;api.ticks=NowTicks;api.wait_tick=WaitTick;
+  api.resolve=Resolve;api.read=ReadContract;api.add=Add;api.remove=Remove;api.create=Create;api.start=Start;api.stop=Stop;api.destroy=Destroy;return api;
+}
+struct HalRuntime {
+  HalCore core;
+  DeviceApi api{};
+  DeviceContract contract{};
+  AudioDeviceIOProcID proc=nullptr;
+  std::atomic<uint64_t> callbacks{0},listener_generation{0};
+  CleanupArbiter cleanup;
+  std::atomic<bool> cleanup_started{false};
+  uint32_t listeners=0;
+  bool claimed=false,prepared=false,start_attempted=false,started=false,pinned=false,exposed=false;
+  // Set before registration. Once any registration API receives this pointer,
+  // it remains retained until process exit, even after successful OS cleanup.
+  std::shared_ptr<HalRuntime> keep_alive;
+};
+namespace {
+class CallbackScope {
+public:
+  explicit CallbackScope(HalRuntime& s)noexcept:state(s){state.callbacks.fetch_add(1,std::memory_order_acq_rel);}
+  ~CallbackScope(){state.callbacks.fetch_sub(1,std::memory_order_release);}
+private:HalRuntime& state;
+};
+OSStatus Listener(AudioObjectID,UInt32,const AudioObjectPropertyAddress*,void* context)noexcept {
+  auto& s=*static_cast<HalRuntime*>(context);CallbackScope scope(s);
+  s.listener_generation.fetch_add(1);s.core.Retire(Reason::route);return noErr;
+}
+OSStatus IOProc(AudioDeviceID device,const AudioTimeStamp* now,const AudioBufferList*,const AudioTimeStamp*,AudioBufferList* output,const AudioTimeStamp* when,void* context)noexcept {
+  auto& s=*static_cast<HalRuntime*>(context);CallbackScope scope(s);
+  const uint64_t entry=s.api.ticks();
+  // AudioHardware.h's public IOProc contract guarantees zero-on-entry. Never
+  // touch or traverse malformed spans; leave the OS-provided silence intact.
+  if(!output||output->mNumberBuffers!=1||!now||!when||device!=s.contract.device||
+     !output->mBuffers[0].mData||output->mBuffers[0].mDataByteSize!=kBytes||
+     output->mBuffers[0].mNumberChannels!=2){s.core.Retire(Reason::layout);return noErr;}
+  CallbackInput in{};in.output=static_cast<float*>(output->mBuffers[0].mData);in.output_bytes=output->mBuffers[0].mDataByteSize;
+  in.channels=output->mBuffers[0].mNumberChannels;in.buffers=output->mNumberBuffers;in.output_sample_time=when->mSampleTime;
+  in.output_ticks=when->mHostTime;in.now_ticks=now->mHostTime;in.entry_ticks=entry;in.exit_ticks=entry;
+  in.output_flags=when->mFlags;in.now_flags=now->mFlags;in.timebase_numer=s.contract.timebase_numer;in.timebase_denom=s.contract.timebase_denom;
+  in.read_exit_ticks=s.api.ticks;s.core.Render(in);return noErr;
+}
+void CleanupWorker(std::shared_ptr<HalRuntime> s)noexcept {
+  bool clean=true;
+  if(s->proc&&s->start_attempted&&s->api.stop(s->contract.device,s->proc)!=noErr)clean=false;
+  if(s->proc&&s->api.destroy(s->contract.device,s->proc)!=noErr)clean=false;
+  for(uint32_t n=0;n<s->listeners;++n)if(s->api.remove(s->contract,n,Listener,s.get())!=noErr)clean=false;
+  // Observe already-entered callbacks, but never infer closure of queued entry
+  // from successful unregisters or a zero counter. Exposed state is retained.
+  while(clean&&s->callbacks.load(std::memory_order_acquire)!=0)s->api.wait_tick();
+  const CleanupResult outcome=clean?CleanupResult::clean:CleanupResult::failed;
+  if(s->cleanup.Choose(outcome)) {
+    if(clean&&!s->exposed) {s->keep_alive.reset();ModuleGate().Release();}
+    else ModuleGate().Quarantine();
+  }
+  // A timeout winner keeps both its claim and context. A late worker cannot
+  // change that result or quarantine a later successfully admitted session.
+
+}
+// Owner-only. For retained outcomes the original claim has never been released,
+// so idempotent quarantine cannot affect a newly admitted owner. This also
+// ensures a reported retained result has visible quarantine before return.
+CleanupResult ReportCleanup(HalRuntime& s,CleanupResult result)noexcept {
+  if(s.exposed||result!=CleanupResult::clean)ModuleGate().Quarantine();
+  else s.claimed=false;
+  return result;
+}
+}
+HalSessionState::HalSessionState():state_(std::make_shared<HalRuntime>()){}
+HalCore& HalSessionState::Core()noexcept{return state_->core;}
+HalDevice::HalDevice(DeviceApi api):api_(api){
+  static_assert(ATOMIC_POINTER_LOCK_FREE==2&&ATOMIC_LLONG_LOCK_FREE==2,"bounded cancellation requires lock-free atomics");
+}
+HalDevice::~HalDevice(){if(state_&&state_->claimed)Cleanup(UINT64_MAX);}
+bool HalDevice::Cancelled()noexcept {
+  if(!stop_requested_.load())return false;
+  if(state_)state_->core.Retire(Reason::cancelled);return true;
+}
+Status HalDevice::Prepare(HalSessionState& session)noexcept {
+  if(stop_requested_.load()){session.Core().Retire(Reason::cancelled);return Status::retired;}
+  if(Quarantined())return Status::quarantined;
+  if(state_||session.state_->claimed||session.state_->core.Retired()||!api_.pin||!api_.now_ns||!api_.ticks||!api_.wait_tick||!api_.resolve||!api_.read||!api_.add||!api_.remove||!api_.create||!api_.start||!api_.stop||!api_.destroy)return Status::invalid;
+  if(!ModuleGate().Claim())return Quarantined()?Status::quarantined:Status::invalid;
+  state_=session.state_;auto& s=*state_;s.api=api_;s.claimed=true;
+  published_core_.store(&s.core);
+  // SC store/load pairs with RequestStop's latch-store/pointer-load: either
+  // the canceller observes this pointer or this owner observes cancellation.
+  if(Cancelled())return Status::retired;
+  if(!s.core.Ready()||!s.callbacks.is_lock_free()||!s.listener_generation.is_lock_free()||!s.cleanup.Ready()||api_.pin()!=Status::ok) {
+    // Nothing has registered. In particular, a failed pin must never dispatch
+    // an asynchronous cleanup function whose containing image can unload.
+    s.core.Retire(Reason::route);s.claimed=false;ModuleGate().Release();return Status::invalid;
+  }
+  s.pinned=true;
+  if(Cancelled())return Status::retired;
+  if(api_.resolve(s.contract)!=noErr){s.core.Retire(Reason::route);return Status::invalid;}
+  if(Cancelled())return Status::retired;
+  s.keep_alive=state_;
+  const uint64_t guard=s.listener_generation.load();
+  for(uint32_t n=0;n<kGuardCount;++n){
+    if(Cancelled())return Status::retired;
+    s.exposed=true; // before the call, including failed registration attempts
+    if(api_.add(s.contract,n,Listener,&s)!=noErr){s.core.Retire(Reason::route);return Status::invalid;}
+    ++s.listeners;if(Cancelled())return Status::retired;
+  }
+  if(api_.read(s.contract)!=noErr||api_.read(s.contract)!=noErr||s.listener_generation.load()!=guard||s.core.Retired()) {s.core.Retire(Reason::route);return Status::invalid;}
+  s.exposed=true;
+  if(api_.create(s.contract.device,IOProc,&s,&s.proc)!=noErr){s.proc=nullptr;s.core.Retire(Reason::route);return Status::invalid;}
+  if(Cancelled())return Status::retired;
+  s.prepared=true;return Status::ok;
+}
+Status HalDevice::CheckGuards()noexcept {
+  if(!state_||!state_->prepared)return Status::invalid;
+  auto& s=*state_;if(s.core.Retired())return Status::retired;
+  const uint64_t generation=s.listener_generation.load();
+  if(api_.read(s.contract)!=noErr||s.listener_generation.load()!=generation){s.core.Retire(Reason::route);return Status::retired;}
+  return s.core.Retired()?Status::retired:Status::ok;
+}
+Status HalDevice::Start()noexcept {
+  if(CheckGuards()!=Status::ok||state_->started)return Status::invalid;
+  auto& s=*state_;s.start_attempted=true;
+  if(api_.start(s.contract.device,s.proc)!=noErr){s.core.Retire(Reason::route);return Status::invalid;}
+  s.started=true;return s.core.Retired()?Status::retired:Status::ok;
+}
+void HalDevice::RequestStop()noexcept {
+  stop_requested_.store(1);
+  if(auto* core=published_core_.load())core->Retire(Reason::cancelled);
+}
+CleanupResult HalDevice::Cleanup(uint64_t deadline)noexcept {
+  if(!state_||!state_->claimed)return CleanupResult::clean;
+  auto s=state_;s->core.Retire(Reason::cleanup);
+  CleanupResult result=CleanupResult::failed;
+  if(s->cleanup.Result(result))return ReportCleanup(*s,result);
+  if(!s->pinned) {
+    // Cancellation can win before pinning, with no exposed context. Keep that
+    // entire cleanup synchronous so no unpinned worker can outlive the caller.
+    if(s->cleanup.Choose(CleanupResult::clean)){s->keep_alive.reset();ModuleGate().Release();}
+    s->cleanup.Result(result);return ReportCleanup(*s,result);
+  }
+  uint64_t now=api_.now_ns(),maximum=0;
+  if(!AddNs(now,2000000000,maximum))maximum=UINT64_MAX;
+  deadline=std::min(deadline,maximum);
+  bool expected=false;
+  if(s->cleanup_started.compare_exchange_strong(expected,true)) {
+    // Even failure to create a cleanup worker must retain live callback state.
+    s->keep_alive=s;
+    try{std::thread(CleanupWorker,s).detach();}
+    catch(...){if(s->cleanup.Choose(CleanupResult::failed))ModuleGate().Quarantine();}
+  }
+  while(!s->cleanup.Result(result)&&now<deadline) {api_.wait_tick();now=api_.now_ns();}
+  if(s->cleanup.Choose(CleanupResult::timeout_quarantined))ModuleGate().Quarantine();
+  // Choose is single-winner: a stale pending read can never quarantine after
+  // clean completion released the claim to another session.
+  s->cleanup.Result(result);
+  return ReportCleanup(*s,result);
+}
+}
diff --git a/src/OwnedHalDevice.h b/src/OwnedHalDevice.h
new file mode 100644
index 0000000..269927b
--- /dev/null
+++ b/src/OwnedHalDevice.h
@@ -0,0 +1,31 @@
+#pragma once
+#include "OwnedHalLifetime.h"
+#include <CoreAudio/CoreAudio.h>
+#include <memory>
+namespace owned_hal {
+constexpr uint32_t kGuardCount=9;
+struct DeviceContract {AudioDeviceID device=0;AudioStreamID stream=0;uint32_t timebase_numer=0,timebase_denom=0;};
+struct DeviceApi {
+ Status (*pin)() noexcept=nullptr;uint64_t (*now_ns)() noexcept=nullptr;uint64_t (*ticks)() noexcept=nullptr;void (*wait_tick)() noexcept=nullptr;
+ OSStatus (*resolve)(DeviceContract&) noexcept=nullptr;OSStatus (*read)(const DeviceContract&) noexcept=nullptr;
+ OSStatus (*add)(const DeviceContract&,uint32_t,AudioObjectPropertyListenerProc,void*) noexcept=nullptr;
+ OSStatus (*remove)(const DeviceContract&,uint32_t,AudioObjectPropertyListenerProc,void*) noexcept=nullptr;
+ OSStatus (*create)(AudioDeviceID,AudioDeviceIOProc,void*,AudioDeviceIOProcID*) noexcept=nullptr;
+ OSStatus (*start)(AudioDeviceID,AudioDeviceIOProcID) noexcept=nullptr;
+ OSStatus (*stop)(AudioDeviceID,AudioDeviceIOProcID) noexcept=nullptr;
+ OSStatus (*destroy)(AudioDeviceID,AudioDeviceIOProcID) noexcept=nullptr;
+};
+DeviceApi PublicDeviceApi()noexcept;
+struct HalRuntime;
+class HalSessionState {public:HalSessionState();HalCore& Core()noexcept;private:friend class HalDevice;std::shared_ptr<HalRuntime> state_;};
+class HalDevice {public:explicit HalDevice(DeviceApi api=PublicDeviceApi());
+  HalDevice(const HalDevice&)=delete;HalDevice& operator=(const HalDevice&)=delete;~HalDevice();Status Prepare(HalSessionState&)noexcept;Status Start()noexcept;Status CheckGuards()noexcept;void RequestStop()noexcept;CleanupResult Cleanup(uint64_t)noexcept;private:
+  bool Cancelled()noexcept;
+  DeviceApi api_;
+  // Owner-only shared_ptr; never accessed by RequestStop. The published core
+  // remains owned by state_ until this facade's destruction.
+  std::shared_ptr<HalRuntime> state_;
+  std::atomic<HalCore*> published_core_{nullptr};
+  std::atomic<uint64_t> stop_requested_{0};};
+
+}
diff --git a/src/OwnedHalLifetime.h b/src/OwnedHalLifetime.h
new file mode 100644
index 0000000..130dda4
--- /dev/null
+++ b/src/OwnedHalLifetime.h
@@ -0,0 +1,69 @@
+#pragma once
+#include "OwnedHalCore.h"
+#include <dlfcn.h>
+#include <mutex>
+#include <cstring>
+
+// This symbol must be defined in the addon image (OwnedHalDevice.cpp). The test
+// dylib defines its own marker. Never substitute a Kodi/private loader handle.
+extern "C" __attribute__((visibility("default"))) void OwnedHalModuleIdentityV1();
+namespace owned_hal {
+class LifetimeGate {
+public:
+  bool Claim()noexcept {uint64_t expected=0;return state_.is_lock_free()&&state_.compare_exchange_strong(expected,1);}
+  void Release()noexcept {state_.fetch_and(~uint64_t(1));}
+  void Quarantine()noexcept {state_.fetch_or(2);}
+  bool IsQuarantined()const noexcept {return (state_.load()&2)!=0;}
+private:
+  std::atomic<uint64_t> state_{0};
+};
+// One terminal choice per session. Choose(clean) precedes claim release;
+// timeout/failure callers that lose the CAS must never touch the module gate.
+class CleanupArbiter {
+public:
+ bool Ready()const noexcept{return outcome_.is_lock_free();}
+ bool Choose(CleanupResult result)noexcept {
+   uint64_t expected=0;return outcome_.compare_exchange_strong(expected,Encode(result));
+ }
+ bool Result(CleanupResult& result)const noexcept {
+   const uint64_t value=outcome_.load();if(!value)return false;
+   result=value==1?CleanupResult::clean:(value==2?CleanupResult::failed:CleanupResult::timeout_quarantined);return true;
+ }
+private:
+ static uint64_t Encode(CleanupResult result)noexcept {
+   return result==CleanupResult::clean?1:(result==CleanupResult::failed?2:3);
+ }
+ std::atomic<uint64_t> outcome_{0};
+};
+// Hidden inline functions give one registry per loaded addon, not a symbol that
+// another plugin can interpose. A successful self-reference is NEVER dlclosed.
+__attribute__((visibility("hidden"))) inline LifetimeGate& ModuleGate()noexcept {static LifetimeGate gate;return gate;}
+struct ModulePinState {
+  std::once_flag once;
+  Status status=Status::invalid;
+  void* retained_handle=nullptr;
+  std::atomic<unsigned> count{0};
+};
+__attribute__((visibility("hidden"))) inline ModulePinState& PinState()noexcept {static ModulePinState state;return state;}
+__attribute__((visibility("hidden"),noinline)) inline void OwnCodeAnchor()noexcept {}
+__attribute__((visibility("hidden"))) inline Status PinOwnModule()noexcept {
+  auto& state=PinState();
+  try {
+    std::call_once(state.once,[&state] {
+      Dl_info own{};void* marker=reinterpret_cast<void*>(&OwnedHalModuleIdentityV1);
+      if(!dladdr(reinterpret_cast<void*>(&OwnCodeAnchor),&own)||!own.dli_fname||!own.dli_fbase)return;
+      void* handle=dlopen(own.dli_fname,RTLD_NOW|RTLD_LOCAL|RTLD_NOLOAD);
+      if(!handle)return;
+      void* symbol=dlsym(handle,"OwnedHalModuleIdentityV1");Dl_info resolved{};
+      if(symbol!=marker||!dladdr(symbol,&resolved)||resolved.dli_fbase!=own.dli_fbase||
+          !resolved.dli_fname||std::strcmp(resolved.dli_fname,own.dli_fname)!=0) {
+        dlclose(handle);return;
+      }
+      state.retained_handle=handle;state.count.store(1);state.status=Status::ok;
+    });
+  }catch(...){return Status::invalid;}
+  return state.status;
+}
+__attribute__((visibility("hidden"))) inline unsigned OwnModulePinCount()noexcept {return PinState().count.load();}
+__attribute__((visibility("hidden"))) inline bool Quarantined()noexcept {return ModuleGate().IsQuarantined();}
+}
diff --git a/src/OwnedHostOverride.h b/src/OwnedHostOverride.h
new file mode 100644
index 0000000..67b1c77
--- /dev/null
+++ b/src/OwnedHostOverride.h
@@ -0,0 +1,145 @@
+#pragma once
+// One bounded dependency token. OS operations are injected; no worker is owned here.
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <ostream>
+#include <utility>
+namespace owned_override {
+struct StartResult { void* token; int status; };
+struct Snapshot {
+  bool enabled=false,active=false,allowed=false,failed=false,terminal=false,ownerRunning=false;
+  uint64_t suspensionEpoch=0;
+  uint64_t generation=1,revision=0,ownerId=0,targetId=0,starts=0,startAttempts=0,endAttempts=0,ends=0;
+  uint64_t ignoredPreparation=0,blockedThrough=0,outstanding=0,maxOutstanding=0,lastStartNs=0,lastEndNs=0,lastEndOwner=0;
+  int lastStartStatus=-1,lastEndStatus=-1;
+  const char* reason="none";
+};
+class State {
+ public:
+  bool Reset(bool enabled) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if(token || state.ownerRunning) return false;
+    state=Snapshot{};state.enabled=enabled;nativePaused=false;releasePending=false;lastSuspendedNs=0;return true;
+  }
+  bool OwnerBegin(uint64_t id) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if(!state.enabled)return true;
+    if(!id || state.ownerRunning || state.terminal) { Fail("owner_invalid");return false; }
+    state.ownerId=id;state.ownerRunning=true;++state.generation;return true;
+  }
+  Snapshot Get() const {
+    std::lock_guard<std::mutex> lock(mutex);
+    auto out=state;out.outstanding=token ? 1 : 0;
+    out.active=token && !releasePending && !nativePaused && state.allowed && state.ownerRunning && !state.failed && !state.terminal;
+    return out;
+  }
+  void Suspend(uint64_t now) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if(!state.enabled)return;
+    ++state.suspensionEpoch;++state.generation;
+    lastSuspendedNs=now;nativePaused=true;
+    if(token)releasePending=true; // Native resume cannot cancel owner cleanup.
+    state.blockedThrough=state.revision;state.allowed=false;
+  }
+  void ResumeNative() {
+    std::lock_guard<std::mutex> lock(mutex);
+    if(state.enabled && nativePaused) { nativePaused=false;++state.generation; }
+  }
+  void Stop() {
+    std::lock_guard<std::mutex> lock(mutex);StopLocked();
+  }
+  template<class End> void Control(uint64_t owner,uint64_t revision,bool active,uint64_t suspensionEpoch,uint64_t issued,End end,uint64_t now) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if(!state.enabled)return;
+    if(!state.ownerRunning || owner!=state.ownerId) { Fail("owner_invalid");return; }
+    // Consume pause debt before a fresh resume can permit another acquisition.
+    if(releasePending)Release(owner,end,now);
+    if(revision<state.revision) Fail("control_reversed");
+    if(revision>state.revision) { state.revision=revision;++state.generation; }
+    // Fence the entire Apply-to-publication transaction, not just acquisition.
+    // A queued pre-pause command is stale even if first read after suspension.
+    if(!active || suspensionEpoch!=state.suspensionEpoch ||
+       (state.suspensionEpoch && issued<=lastSuspendedNs)) {
+      state.blockedThrough=state.revision;
+      if(state.allowed)++state.generation;
+      state.allowed=false;
+    } else if(!state.failed && !state.terminal && state.revision>state.blockedThrough) {
+      if(!state.allowed)++state.generation;
+      state.allowed=true;
+    }
+    if(nativePaused || !state.allowed || state.failed || state.terminal) Release(owner,end,now);
+  }
+  template<class Start> bool Acquire(uint64_t generation,uint64_t id,const char* name,bool ready,Start start,uint64_t now) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if(!state.enabled || state.failed || state.terminal || !state.ownerRunning) return false;
+    if(!ready) { ++state.ignoredPreparation;return false; }
+    if(generation!=state.generation || releasePending || nativePaused || !state.allowed)return false;
+    if(state.targetId && state.targetId!=id) { Fail("caller_changed");return false; }
+    if(!state.targetId && name && std::strcmp(name,"JobWorker")==0) { ++state.ignoredPreparation;return false; }
+    if(!id || id==state.ownerId || !name || std::strcmp(name,"PAPlayer")!=0) { Fail("unsupported_target");return false; }
+    if(token)return true;
+    state.targetId=id;++state.startAttempts;state.lastStartNs=now;
+    const auto result=start();state.lastStartStatus=result.status;
+    if(result.token) { token=result.token;++state.starts;state.maxOutstanding=1;++state.generation; }
+    if(!result.token || result.status!=0) { Fail("start_failed");return false; }
+    return true;
+  }
+  template<class End> void Finish(uint64_t owner,End end,uint64_t now) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if(!state.enabled)return;
+    StopLocked();
+    // No acquisition is possible before a valid owner begins.
+    if(!state.ownerRunning && !token)return;
+    if(owner!=state.ownerId) { Fail("owner_invalid");return; }
+    Release(owner,end,now);state.ownerRunning=false;++state.generation;
+  }
+ private:
+  void StopLocked() {
+    if(!state.enabled)return;
+    if(!state.terminal || state.allowed)++state.generation;
+    state.terminal=true;state.allowed=false;
+  }
+  void Fail(const char* reason) {
+    if(!state.failed) { state.failed=true;state.reason=reason;++state.generation; }
+    state.allowed=false;
+  }
+  template<class End> void Release(uint64_t owner,End end,uint64_t now) {
+    if(!token)return;
+    if(owner!=state.ownerId || owner==state.targetId) { Fail("cleanup_owner_invalid");return; }
+    void* consumed=token;token=nullptr;releasePending=false; // end consumes even on error; never retry.
+    ++state.endAttempts;state.lastEndNs=now;state.lastEndOwner=owner;++state.generation;
+    state.lastEndStatus=end(consumed);
+    if(state.lastEndStatus==0)++state.ends;else Fail("end_failed");
+  }
+  mutable std::mutex mutex;
+  Snapshot state;
+  void* token=nullptr;
+  bool nativePaused=false,releasePending=false;
+  uint64_t lastSuspendedNs=0;
+};
+template<class Function> class OnExit {
+ public:
+  explicit OnExit(Function function):function(std::move(function)) {}
+  ~OnExit() { function(); }
+  OnExit(const OnExit&)=delete;
+  OnExit& operator=(const OnExit&)=delete;
+ private: Function function;
+};
+inline void WriteJson(std::ostream& out,const Snapshot& s,uint64_t before) {
+  out << "{\"version\":1,\"enabled\":" << (s.enabled ? "true":"false")
+      << ",\"active\":" << (s.active ? "true":"false") << ",\"allowed\":" << (s.allowed ? "true":"false")
+      << ",\"failed\":" << (s.failed ? "true":"false") << ",\"terminal\":" << (s.terminal ? "true":"false")
+      << ",\"owner_running\":" << (s.ownerRunning ? "true":"false")
+      << ",\"generation_before\":" << before << ",\"generation_after\":" << s.generation << ",\"control_revision\":" << s.revision
+      << ",\"owner_id\":" << s.ownerId << ",\"target_id\":" << s.targetId
+      << ",\"target_name\":\"" << (s.targetId ? "PAPlayer":"") << "\",\"requested_class\":25,\"requested_relative_priority\":0"
+      << ",\"start_attempts\":" << s.startAttempts << ",\"starts\":" << s.starts
+      << ",\"end_attempts\":" << s.endAttempts << ",\"ends\":" << s.ends
+      << ",\"ignored_preparation\":" << s.ignoredPreparation << ",\"blocked_through_revision\":" << s.blockedThrough
+      << ",\"outstanding\":" << s.outstanding << ",\"max_outstanding\":" << s.maxOutstanding
+      << ",\"last_start_mach_ns\":" << s.lastStartNs << ",\"last_end_mach_ns\":" << s.lastEndNs
+      << ",\"last_end_owner_id\":" << s.lastEndOwner << ",\"last_start_status\":" << s.lastStartStatus
+      << ",\"last_end_status\":" << s.lastEndStatus << ",\"reason\":\"" << s.reason << "\"}";
+}
+}
diff --git a/src/OwnedPcmHost.h b/src/OwnedPcmHost.h
new file mode 100644
index 0000000..51f8e53
--- /dev/null
+++ b/src/OwnedPcmHost.h
@@ -0,0 +1,53 @@
+#pragma once
+// Exact fixture host projection only; original AAC identity/decoder remain separate.
+#include <kodi/c-api/addon-instance/inputstream.h>
+#include <cstdint>
+#include <cstddef>
+#include <cstring>
+#include <limits>
+#include <ostream>
+namespace owned_pcm {
+constexpr uint64_t Frames=3840, Rate=48000, FrameBytes=8, Bytes=Frames*FrameBytes;
+// GetTime is int milliseconds. Reject before overflow rather than wrap the host.
+constexpr uint64_t MaxFrames=uint64_t(std::numeric_limits<int>::max())*48;
+inline bool ValidCursor(uint64_t frames) { return frames<=MaxFrames-Frames; }
+template<class Info> bool Project(const Info& source,Info& host,bool enabled) {
+  if(!enabled || source.GetStreamType()!=INPUTSTREAM_TYPE_AUDIO || source.GetCodecName()!="aac" ||
+     source.GetSampleRate()!=Rate || source.GetChannels()!=2)return false;
+  host=source;
+  host.SetCodecName("pcm_f32le");host.SetCodecInternalName("pcm_f32le");
+  host.SetCodecProfile(CodecProfileNotNeeded);host.SetCodecFourCC(0);host.ClearExtraData();
+  host.SetChannels(2);host.SetSampleRate(Rate);host.SetBitsPerSample(32);
+  host.SetBlockAlign(FrameBytes);host.SetBitRate(Rate*FrameBytes*8);
+  return true;
+}
+enum class Result { Packet,End,Error };
+struct Snapshot { uint64_t frames=0,packets=0,probeFrames=0,probePackets=0;bool closed=false; };
+class Timeline {
+public:
+  Snapshot State()const {return state;}
+  void Close() {state.closed=true;}
+  void ResetPlayback() {if(!state.closed) {state.frames=state.packets=0;playback=true;}}
+  Result Issue(uint8_t* payload,size_t capacity,bool probe,bool terminal,double& pts,double& duration) {
+    if(terminal)state.closed=true;
+    if(state.closed)return Result::End;
+    const uint64_t cursor=probe ? state.probeFrames : state.frames;
+    if(probe==playback || !payload || capacity!=Bytes || !ValidCursor(cursor)) {state.closed=true;return Result::Error;}
+    pts=static_cast<double>(cursor)*1000000.0/Rate;
+    duration=static_cast<double>(Frames)*1000000.0/Rate;
+    std::memset(payload,0,Bytes); // IEEE754 little-endian float +0 in every channel.
+    if(probe) {state.probeFrames+=Frames;++state.probePackets;}
+    else {state.frames+=Frames;++state.packets;}
+    return Result::Packet;
+  }
+private: Snapshot state;bool playback=false;
+};
+inline void WriteJson(std::ostream& out,const Snapshot& s) {
+  out<<"{\"version\":1,\"codec\":\"pcm_f32le\",\"sample_rate\":48000,\"channels\":2,\"frame_bytes\":8"
+     <<",\"packet_frames\":3840,\"packet_bytes\":30720,\"packet_duration_s\":0.08"
+     <<",\"playback_frames\":"<<s.frames<<",\"playback_packets\":"<<s.packets
+     <<",\"probe_frames\":"<<s.probeFrames<<",\"probe_packets\":"<<s.probePackets
+     <<",\"generation_closed\":"<<(s.closed?"true":"false")
+     <<",\"decoder_packet_remainder_bound_frames\":3840,\"downstream_queued_tail_frames\":null}";
+}
+}
diff --git a/src/OwnedPlayerMode.h b/src/OwnedPlayerMode.h
new file mode 100644
index 0000000..7262467
--- /dev/null
+++ b/src/OwnedPlayerMode.h
@@ -0,0 +1,63 @@
+#pragma once
+// Explicit fixture host contract. No Kodi symbols or target-thread handles.
+#include <cstdint>
+#include <mutex>
+#include <string>
+namespace owned_player {
+inline bool VerifiedPacket(int bytes,int stream,int expectedStream,double pts,bool adts,
+                           const std::string& expectedHash,const std::string& digest) {
+ return bytes>0 && bytes<=8192 && stream==expectedStream && pts==0.0 && !adts &&
+     expectedHash.size()==64 && digest==expectedHash;
+}
+struct Snapshot {
+ std::string mode{"paplayer_pcm_v1"}, core{"PAPlayer"};
+ uint64_t generation{1}, caller{0}, observed{0};
+ bool armed{false}, retired{false};
+};
+struct Proof {
+ bool fresh,normal,metadata,raw,hash;
+ uint64_t accepted,decoded,queued,packets;
+ double pts;
+};
+class State {
+ mutable std::mutex mutex;Snapshot state;bool video{false},videoControl{false},attempted{false};
+public:
+ bool Configure(const std::string& mode,const std::string& core,const std::string& queue="") {
+  std::lock_guard<std::mutex> lock(mutex);state=Snapshot{};attempted=false;
+  videoControl=mode=="videoplayer_video_v1";
+  video=mode=="videoplayer_pcm_v1" || videoControl;
+  if((videoControl && queue!="40") || (!videoControl && !queue.empty())){state.retired=true;return false;}
+  if((mode.empty() && core.empty()) || (mode=="paplayer_pcm_v1" && core=="PAPlayer"))return true;
+  if(video && core=="VideoPlayer") {state.mode=mode;state.core=core;return true;}
+  state.retired=true;return false;
+ }
+ bool VideoControl() const {return videoControl;}
+ bool Video() const {return video;} // immutable between Open and all worker joins
+ Snapshot Get() const {std::lock_guard<std::mutex> lock(mutex);return state;}
+ void Retire() {std::lock_guard<std::mutex> lock(mutex);if(!state.retired){state.retired=true;++state.generation;}}
+ bool Observe(uint64_t caller,int identity,const std::string& name,int nameStatus,uint64_t now) {
+  std::lock_guard<std::mutex> lock(mutex);
+  if(state.retired)return false;
+  if(!video || !caller || identity || nameStatus || name!="VideoPlayer" || !now || (state.caller && state.caller!=caller)) {
+   state.retired=true;++state.generation;return false;
+  }
+  if(!state.caller){state.caller=caller;state.observed=now;++state.generation;}
+  return true;
+ }
+ template<class Decode> bool Arm(const Proof& p,Decode decode) {
+  {
+   std::lock_guard<std::mutex> lock(mutex);
+   if(state.retired)return false;
+   if(!video || !state.caller || attempted || !p.fresh || !p.normal || !p.metadata || !p.raw || !p.hash ||
+      p.accepted || p.decoded || p.queued || p.packets || p.pts!=0.0) {
+    state.retired=true;++state.generation;return false;
+   }
+   attempted=true;++state.generation;
+  }
+  const bool ok=decode(); // same retained packet, one call; never hold lock into addon code
+  std::lock_guard<std::mutex> lock(mutex);
+  if(!ok || state.retired){state.retired=true;++state.generation;return false;}
+  state.armed=true;++state.generation;return true;
+ }
+};
+}
diff --git a/src/OwnedStallDiagnostics.h b/src/OwnedStallDiagnostics.h
new file mode 100644
index 0000000..cee76e3
--- /dev/null
+++ b/src/OwnedStallDiagnostics.h
@@ -0,0 +1,129 @@
+#pragma once
+// Diagnostic only: fixed storage, no IO, no waiting for instrumentation locks.
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <ostream>
+
+namespace owned_stall {
+enum Operation : size_t {
+  ControlRead, TelemetryWait, TelemetryWrite, TelemetryFlush,
+  RendererOwnedWait, ClockOwnedWait, HostOwnedWait, AddData,
+  SleepOvershoot, HostPacketInterarrival, HostPacketCall, RendererLoop, GetSpace, DecodeOwnedWait, DecodeOwnedHeld, PacketOwnedWait, GuardBefore, GuardAfter, ClockObservation, NativeAppend, HostDemuxCall, HostDemuxInterarrival, Count
+};
+static constexpr const char* Names[] = {
+  "control_read", "telemetry_mutex_wait", "telemetry_write", "telemetry_flush",
+  "renderer_owned_mutex_wait", "clock_owned_mutex_wait", "host_owned_mutex_wait",
+  "adddata", "renderer_sleep_overshoot", "host_packet_interarrival", "host_packet_call", "renderer_loop", "getspace", "decode_owned_mutex_wait", "decode_owned_mutex_held", "packet_owned_mutex_wait",
+  "output_guard_before", "output_guard_after", "clock_observation", "native_append",
+  "host_demux_call", "host_demux_interarrival"
+};
+static_assert(sizeof(Names) / sizeof(Names[0]) == Count, "Operation names must match enum count");
+struct Metric {
+  uint64_t count{0}, maxNs{0}, maxStartNs{0}, maxEndNs{0};
+};
+struct Event { size_t operation{0}; uint64_t startNs{0}, endNs{0}; };
+struct HostThread {
+  uint64_t threadId{0}, observedNs{0};
+  int identityStatus{-1}, qosStatus{-1}, qosClass{-1}, relativePriority{-1};
+};
+struct Snapshot {
+  bool available{false};
+  uint64_t revision{0}, droppedContention{0}, droppedEvents{0};
+  std::array<Metric, Count> metrics{};
+  std::array<Event, 12> events{};
+  size_t eventCount{0};
+  std::array<HostThread, 4> hostThreads{};
+  size_t hostThreadCount{0};
+  uint64_t droppedHostThreads{0};
+};
+class Aggregate {
+ public:
+  // Called only before workers launch, after the previous instance has stopped.
+  void Reset() { pending=Snapshot{}; hostThreads={}; hostThreadCount=0; revision=0; dropped.store(0); }
+  template<class Read> void ObserveHostThread(uint64_t id, int identityStatus, Read read) {
+    std::unique_lock<std::mutex> guard(mutex,std::try_to_lock);
+    if (!guard.owns_lock()) { dropped.fetch_add(1,std::memory_order_relaxed); return; }
+    for (size_t i=0;i<hostThreadCount;++i)
+      if (hostThreads[i].threadId==id && hostThreads[i].identityStatus==identityStatus) return;
+    if (hostThreadCount==hostThreads.size()) { ++pending.droppedHostThreads; return; }
+    // Read-only QoS observation once per retained identity, never a setter.
+    auto observation=read(); observation.threadId=id; observation.identityStatus=identityStatus;
+    hostThreads[hostThreadCount++]=observation;
+  }
+  void Record(Operation op, uint64_t start, uint64_t end) {
+    if (op >= Count || end < start) return;
+    std::unique_lock<std::mutex> guard(mutex, std::try_to_lock);
+    if (!guard.owns_lock()) { dropped.fetch_add(1, std::memory_order_relaxed); return; }
+    auto& metric = pending.metrics[op];
+    ++metric.count;
+    if (end-start >= metric.maxNs) {
+      metric.maxNs=end-start; metric.maxStartNs=start; metric.maxEndNs=end;
+    }
+    if (end-start > 40000000ULL) {
+      if (pending.eventCount < pending.events.size())
+        pending.events[pending.eventCount++] = Event{op,start,end};
+      else ++pending.droppedEvents;
+    }
+  }
+  Snapshot Take() {
+    std::unique_lock<std::mutex> guard(mutex, std::try_to_lock);
+    if (!guard.owns_lock()) return Snapshot{}; // Preserve pending events for next row.
+    Snapshot out=pending;
+    out.available=true; out.revision=++revision;
+    out.hostThreads=hostThreads; out.hostThreadCount=hostThreadCount;
+    out.droppedContention=dropped.exchange(0, std::memory_order_relaxed);
+    pending=Snapshot{};
+    return out;
+  }
+ private:
+  std::mutex mutex;
+  std::atomic<uint64_t> dropped{0};
+  uint64_t revision{0};
+  Snapshot pending{};
+  std::array<HostThread,4> hostThreads{};
+  size_t hostThreadCount{0};
+};
+class Span {
+ public:
+  Span(Aggregate& aggregate, Operation op, uint64_t (*clock)(), bool enabled)
+      : aggregate(aggregate), op(op), clock(clock), enabled(enabled), start(enabled ? clock() : 0) {}
+  uint64_t StartNs() const { return start; }
+  ~Span() { if (enabled) aggregate.Record(op,start,clock()); }
+ private:
+  Aggregate& aggregate;
+  Operation op;
+  uint64_t (*clock)();
+  bool enabled;
+  uint64_t start;
+};
+// Version 3 tuple order and numeric operation IDs are a frozen wire contract.
+// All collected fields are emitted; only repeated JSON labels are removed.
+inline void WriteJson(std::ostream& out, const Snapshot& snapshot) {
+  out << "{\"version\":3,\"header\":[40000000,"
+      << (snapshot.available ? "true" : "false") << ',' << snapshot.revision
+      << ',' << snapshot.droppedContention << ',' << snapshot.droppedEvents
+      << ',' << snapshot.droppedHostThreads << "],\"operations\":[";
+  for (size_t i=0;i<Count;++i) {
+    const auto& m=snapshot.metrics[i];
+    if (i) out << ',';
+    out << '[' << i << ',' << m.count << ',' << m.maxNs
+        << ',' << m.maxStartNs << ',' << m.maxEndNs << ']';
+  }
+  out << "],\"events\":[";
+  for (size_t i=0;i<snapshot.eventCount;++i) {
+    const auto& e=snapshot.events[i];
+    if (i) out << ',';
+    out << '[' << e.operation << ',' << e.startNs << ',' << e.endNs << ']';
+  }
+  out << "],\"threads\":[";
+  for (size_t i=0;i<snapshot.hostThreadCount;++i) {
+    const auto& t=snapshot.hostThreads[i];
+    if(i) out << ',';
+    out << '[' << t.threadId << ',' << t.observedNs << ',' << t.identityStatus
+        << ',' << t.qosStatus << ',' << t.qosClass << ',' << t.relativePriority << ']';
+  }
+  out << "]}";
+}
+} // namespace owned_stall
diff --git a/src/OwnedVideoHost.h b/src/OwnedVideoHost.h
new file mode 100644
index 0000000..502806d
--- /dev/null
+++ b/src/OwnedVideoHost.h
@@ -0,0 +1,81 @@
+#pragma once
+// Fixture-only control video. No audio data or clock estimation lives here.
+#include <kodi/c-api/addon-instance/inputstream.h>
+#include <cstdint>
+#include <cstddef>
+#include <cstring>
+#include <limits>
+#include <ostream>
+#include <vector>
+namespace owned_video {
+constexpr size_t Bytes=384;
+constexpr uint64_t StartupNs=30000000000ULL,HoldNs=1000000000ULL,TotalSamples=8641536;
+constexpr uint64_t SamplesPerFrame=4800,LeadFrames=60;
+template<class Info> bool Project(const Info& source,Info& host) {
+ if(source.GetStreamType()!=INPUTSTREAM_TYPE_AUDIO || source.GetCodecName()!="aac" ||
+    source.GetSampleRate()!=48000 || source.GetChannels()!=2)return false;
+ host=Info{};host.SetStreamType(INPUTSTREAM_TYPE_VIDEO);
+ // Kodi DVDDemuxClient gates rawvideo on nonempty extradata. FFmpeg ignores this one-byte marker.
+ // SetExtraData owns the vector; original AAC bytes remain separate.
+ host.SetExtraData(std::vector<uint8_t>{0});
+ host.SetCodecName("rawvideo");host.SetCodecInternalName("rawvideo");
+ host.SetCodecProfile(CodecProfileNotNeeded);host.SetCodecFourCC(0x30323449);
+ host.SetWidth(16);host.SetHeight(16);host.SetAspect(1.0f);host.SetFpsRate(10);host.SetFpsScale(1);
+ host.SetBitRate(30720);host.SetColorSpace(INPUTSTREAM_COLORSPACE_BT709);host.SetColorRange(INPUTSTREAM_COLORRANGE_LIMITED);
+ return true;
+}
+enum class Result { Frame,Retry,End,Error };
+struct Snapshot {
+ uint64_t openNs=0,startDeadline=0,startAckNs=0,drainNs=0,holdDeadline=0,eofNs=0,lastFrameNs=0,frames=0;
+ bool armed=false,drained=false,closed=false,failed=false;
+};
+class Timeline {
+ Snapshot s;bool pending=false;
+ bool Fail() {s.failed=true;s.closed=true;pending=false;return false;}
+public:
+ Snapshot Get()const{return s;}
+ bool Open(uint64_t now) {
+  s=Snapshot{};pending=false;
+  if(!now || now>std::numeric_limits<uint64_t>::max()-StartupNs)return Fail();
+  s.openNs=now;s.startDeadline=now+StartupNs;return true;
+ }
+ bool Arm() {if(!s.openNs || s.closed || s.armed)return Fail();s.armed=true;return true;}
+ bool Expired(uint64_t now)const {return !s.startAckNs && (now<s.openNs || now>=s.startDeadline);}
+ bool AcknowledgeStart(uint64_t now) {
+  if(s.closed || !s.armed || now<s.openNs || Expired(now))return Fail();
+  if(!s.startAckNs)s.startAckNs=now;
+  return true;
+ }
+ bool Drain(uint64_t now) {
+  if(s.drained)return !s.failed;
+  if(s.closed || !s.armed || !s.startAckNs || now<s.openNs || now>std::numeric_limits<uint64_t>::max()-HoldNs)return Fail();
+  s.drained=true;s.drainNs=now;s.holdDeadline=now+HoldNs;pending=false;return true;
+ }
+ void Close(uint64_t now) {s.closed=true;pending=false;if(!s.eofNs)s.eofNs=now;}
+ Result Next(uint64_t now,uint64_t accepted,bool cancel) {
+  pending=false;
+  if(cancel){Close(now);return Result::End;}
+  if(s.closed)return s.failed ? Result::Error : Result::End;
+  if(!s.armed || now<s.openNs || Expired(now) || accepted>TotalSamples){Fail();return Result::Error;}
+  if(s.drained){if(now<s.holdDeadline)return Result::Retry;Close(now);return Result::End;}
+  if(s.frames>=accepted/SamplesPerFrame+LeadFrames)return Result::Retry;
+  pending=true;return Result::Frame;
+ }
+ bool Fill(uint8_t* payload,size_t size,uint64_t now,double& pts,double& duration) {
+  if(s.closed || s.drained || !pending || !payload || size!=Bytes || now<s.openNs)return Fail();
+  pending=false;pts=static_cast<double>(s.frames)*100000.0;duration=100000.0;
+  std::memset(payload,16,256);std::memset(payload+256,128,128);
+  ++s.frames;s.lastFrameNs=now;return true;
+ }
+};
+inline void WriteJson(std::ostream& out,const Snapshot& s) {
+ out<<"{\"video_extradata_hex\":\"00\",\"version\":1,\"stream_type\":\"video\",\"codec\":\"rawvideo\",\"fourcc\":808596553,\"width\":16,\"height\":16"
+    <<",\"fps_rate\":10,\"fps_scale\":1,\"packet_bytes\":384,\"packet_duration_s\":0.1,\"lead_frames\":60"
+    <<",\"video_frames\":"<<s.frames<<",\"last_frame_mach_ns\":"<<s.lastFrameNs
+    <<",\"native_open_mach_ns\":"<<s.openNs<<",\"startup_deadline_mach_ns\":"<<s.startDeadline
+    <<",\"start_ack_mach_ns\":"<<s.startAckNs<<",\"owned_drained_mach_ns\":"<<s.drainNs
+    <<",\"hold_deadline_mach_ns\":"<<s.holdDeadline<<",\"host_eof_mach_ns\":"<<s.eofNs
+    <<",\"generation_closed\":"<<((s.drained||s.closed)?"true":"false")<<",\"failed\":"<<(s.failed?"true":"false")
+    <<",\"downstream_queued_tail_frames\":null}";
+}
+}
