+// Exactly one decoder producer and one callback consumer; Finish is producer-only.
+// Monotone counters never wrap: reject the practically unreachable exhaustion.
+template<class Atomic=std::atomic<uint64_t>> class BasicSourceQueue {
+public:
+  bool Ready()const noexcept {return read_.is_lock_free()&&write_.is_lock_free()&&end_.is_lock_free();}
+  bool Push(const float* data,uint32_t frames)noexcept {
+    if(!Ready()||!data||!frames||frames>kSourceCapacity||end_.load(std::memory_order_acquire)!=UINT64_MAX)return false;
+    const uint64_t w=write_.load(std::memory_order_relaxed),r=read_.load(std::memory_order_acquire);
+    if(w<r||w-r>kSourceCapacity||frames>kSourceCapacity-(w-r)||w>UINT64_MAX-frames-1)return false;
+    for(uint32_t i=0;i<frames;++i) {const size_t p=((w+i)%kSourceCapacity)*2;pcm_[p]=data[2*i];pcm_[p+1]=data[2*i+1];}
+    write_.store(w+frames,std::memory_order_release);return true;
+  }
+  bool Finish()noexcept {
+    if(!Ready()||end_.load(std::memory_order_relaxed)!=UINT64_MAX)return false;
+    end_.store(write_.load(std::memory_order_relaxed),std::memory_order_release);return true;
+  }
+  uint32_t Available()const noexcept {
+    const uint64_t w=write_.load(std::memory_order_acquire),r=read_.load(std::memory_order_relaxed);
+    return w>=r&&w-r<=kSourceCapacity?static_cast<uint32_t>(w-r):0;
+  }
+  uint64_t End()const noexcept {return end_.load(std::memory_order_acquire);}
+  uint64_t Consumed()const noexcept {return read_.load(std::memory_order_acquire);}
+  uint32_t Copy(float* out,uint32_t frames,double gain)noexcept {
+    if(!out||frames>Available())return 0;
+    const uint64_t r=read_.load(std::memory_order_relaxed);
+    for(uint32_t i=0;i<frames;++i) {const size_t p=((r+i)%kSourceCapacity)*2;out[2*i]=static_cast<float>(pcm_[p]*gain);out[2*i+1]=static_cast<float>(pcm_[p+1]*gain);}
+    read_.store(r+frames,std::memory_order_release);return frames;
+  }
+private:
+  std::array<float,kSourceCapacity*2> pcm_{}; // allocated and touched before registration
+  Atomic read_{},write_{};
+  Atomic end_{UINT64_MAX};
+};
+using SourceQueue=BasicSourceQueue<>;
+class EvidenceQueue {
+public:
+  bool Ready()const noexcept {return read_.is_lock_free()&&write_.is_lock_free();}
