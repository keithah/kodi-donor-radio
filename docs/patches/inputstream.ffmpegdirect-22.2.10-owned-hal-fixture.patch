+bool InputStreamFFmpegDirect::RewriteOwnedHlsHostPacket(DEMUX_PACKET* packet,
+                                                       size_t sourceFrameCount)
+{
+  if (!packet || sourceFrameCount == 0 || packet->pts == STREAM_NOPTS_VALUE)
+    return false;
+
+  std::lock_guard<std::mutex> lock(m_ownedMutex);
+  if (!m_ownedHostPtsValid)
+  {
+    m_ownedHostNextPts = packet->pts;
+    m_ownedHostPtsValid = true;
+  }
+  if (!std::isfinite(m_ownedHostNextPts))
+    return false;
+
+  const double hostPts = m_ownedHostNextPts;
+  const double hostDuration = m_ownedFrameDuration * sourceFrameCount;
+  if (!std::isfinite(hostDuration) || hostDuration <= 0.0 ||
+      !std::isfinite(hostPts + hostDuration) ||
+      sourceFrameCount > std::numeric_limits<uint64_t>::max() - m_ownedHostOutputFrames)
+    return false;
+
+  packet->pts = hostPts;
+  packet->dts = hostPts;
+  packet->duration = hostDuration;
+  if (std::isfinite(hostPts) &&
+      hostPts >= static_cast<double>(std::numeric_limits<int>::min()) * STREAM_TIME_BASE / 1000.0 &&
+      hostPts <= static_cast<double>(std::numeric_limits<int>::max()) * STREAM_TIME_BASE / 1000.0)
+    m_ownedHostTimeMs.store(static_cast<int>(hostPts * 1000.0 / STREAM_TIME_BASE));
+  m_ownedHostNextPts = hostPts + hostDuration;
+  m_ownedHostOutputFrames += static_cast<uint64_t>(sourceFrameCount);
+  return true;
+}
