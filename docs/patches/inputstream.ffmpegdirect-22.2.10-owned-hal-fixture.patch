+              }
+            }
+            if(next.state!="waiting"&&!beginIntent()){RevokeOwnedClock("hal_intent_exhausted");break;}
+            m_ownedClock->Acknowledge(now);
+            // Prepare this transition on the next bounded owner iteration.
+            continue;
+          }
+        }
+        if(now>=nextGainPoll) {
+          std::vector<owned_clock::Gain> pending;
+          if(!m_ownedClockTransport->PollGain(gain.revision,pending)){RevokeOwnedClock("gain_transport");break;}
+          if(!pending.empty()) {
+            const auto& next=pending.front();
+            const bool changed=!gain.revision||owned_hal::KodiGain(gain.volume,gain.muted)!=owned_hal::KodiGain(next.volume,next.muted)||gain.muted!=next.muted;
+            const uint64_t epoch=gain.epoch+changed;
+            if(next.nonce!=m_ownedClockNonce||next.incarnation!=m_ownedClockIncarnation||next.timeline!=m_ownedClockTimeline||
+               next.device!=1||next.revision!=gain.revision+1||next.epoch!=epoch||next.issue>now||next.start<m_ownedClockOpenNs||
+               (gain.revision&&next.start<=gain.start)||std::abs(next.multiplier-owned_hal::KodiGain(next.volume,next.muted))>1e-12||now>=next.expiry)
+              {RevokeOwnedClock("gain_command");break;}
+            if(changed&&!beginIntent()){RevokeOwnedClock("hal_intent_exhausted");break;}
+            gain=next;
+          }
+          nextGainPoll=now+20000000;
+        }
+      }
+    }
+    if(holding) {
+      const auto offered=core.Publish(held);
+      if(offered==owned_hal::Status::ok) {
+        queued=held;haveQueued=true;holding=false;++queuedSequence;
+        std::ostringstream event;event<<"{\"kind\":\"owned_hal_offer_queued\",\"publication_sequence\":"<<queuedSequence
+          <<",\"gain_revision\":"<<queued.gain_revision<<",\"playback_revision\":"<<queued.playback_revision
+          <<",\"effective_intent\":"<<queued.effective_intent<<",\"queued_not_applied\":true}";WriteOwnedTelemetryLine(event.str());
+      } else if(offered!=owned_hal::Status::busy)break;
+    }
+    drainEvidence();
+    m_ownedAcceptedFrames=core.source.Consumed();
+    const uint64_t finalEnd=core.FinalEndNs();
+    if(finalEnd&&now>=finalEnd) {
+      if(!natural) {
+        natural=true;m_ownedDrained=true;
+        {std::lock_guard<std::mutex> lock(m_ownedMutex);if(!m_ownedVideoHost.Drain(finalEnd)){RevokeOwnedClock("hal_eof_host");break;}}
+        terminal("natural_eof",finalEnd);
+      }
+      if(now>=core.HoldUntilNs())break;
+    }
+    {std::lock_guard<std::mutex> lock(m_ownedMutex);if(m_ownedVideoHost.Expired(now)){RevokeOwnedClock("video_startup_timeout");break;}}
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+  if(!natural)terminal("retired",0);
+  // Capture natural EOF before Cleanup changes the core reason to cleanup.
+  const auto failureBeforeCleanup=core.Failure();
+  m_ownedHalDevice.RequestStop();
+  const auto cleanup=m_ownedHalDevice.Cleanup(MachAbsoluteNowNs()+2000000000ULL);
+  drainEvidence();
+  if(!natural||failureBeforeCleanup!=owned_hal::Reason::none||cleanup!=owned_hal::CleanupResult::clean)m_ownedFailed=true;
+  terminal(cleanup==owned_hal::CleanupResult::clean?"cleanup_clean":"cleanup_failed",natural?core.FinalEndNs():0,static_cast<int>(cleanup));
+  m_ownedSourceStop=true;
+}
