+    std::memcpy(&c,words.data(),sizeof(c));return true;
+  }
+  bool Acquire(uint64_t generation)const noexcept {return generation_.load()==generation&&generation&&!(generation&(kRetired|1));}
+  void Retire()noexcept {generation_.fetch_or(kRetired);}
+  uint64_t Generation()const noexcept {return generation_.load();}
+private:
+  std::array<std::atomic<uint64_t>,kWords> words_{};
+  std::atomic<uint64_t> generation_{0};
+};
