+}
+Status HalDevice::CheckGuards()noexcept {
+  if(!state_||!state_->prepared)return Status::invalid;
+  auto& s=*state_;if(s.core.Retired())return Status::retired;
+  const uint64_t generation=s.listener_generation.load();
+  if(api_.read(s.contract)!=noErr||s.listener_generation.load()!=generation){s.core.Retire(Reason::route);return Status::retired;}
