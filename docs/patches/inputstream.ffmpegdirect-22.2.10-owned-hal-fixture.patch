+    for(uint32_t i=0;i<frames;++i) {const size_t p=((r+i)%kSourceCapacity)*2;out[2*i]=static_cast<float>(pcm_[p]*gain);out[2*i+1]=static_cast<float>(pcm_[p+1]*gain);}
