+// Atomic words avoid the undefined non-atomic data races of a conventional seqlock.
+// All SC operations share a total order. One owner publishes; any thread retires.
+// Acquire's final generation read IS the block linearization point. A later
+// publication/revocation may not undo that block's source advancement.
+class ControlMailbox {
+public:
+  static constexpr uint64_t kRetired=uint64_t(1)<<63;
+  static constexpr size_t kWords=sizeof(EffectiveControl)/sizeof(uint64_t);
+  static_assert(sizeof(EffectiveControl)%sizeof(uint64_t)==0,"whole atomic words");
+  static_assert(std::is_trivially_copyable<EffectiveControl>::value,"wire snapshot");
+  ControlMailbox()noexcept {for(auto& w:words_)w.store(0);}
+  bool Ready()const noexcept {if(!generation_.is_lock_free())return false;for(const auto& w:words_)if(!w.is_lock_free())return false;return true;}
+  bool Publish(const EffectiveControl& c)noexcept {
+    uint64_t old=generation_.load();
+    if((old&kRetired)||(old&1)||old>=kRetired-2)return false;
+    if(!generation_.compare_exchange_strong(old,old+1))return false;
+    std::array<uint64_t,kWords> words{};std::memcpy(words.data(),&c,sizeof(c));
+    for(size_t i=0;i<kWords;++i)words_[i].store(words[i]);
+    old+=1;return generation_.compare_exchange_strong(old,old+1); // retirement wins
+  }
+  bool Read(EffectiveControl& c,uint64_t& generation)const noexcept {
+    generation=generation_.load();if(!generation||(generation&1)||(generation&kRetired))return false;
+    std::array<uint64_t,kWords> words{};
