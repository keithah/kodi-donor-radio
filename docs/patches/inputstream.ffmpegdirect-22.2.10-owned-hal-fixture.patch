+    while(core.evidence.Pop(segment)) {
+      if(!WriteHalSegment(segment)){RevokeOwnedClock("hal_ledger");break;}
+      if(!appliedView.Observe(segment)){RevokeOwnedClock("hal_applied_tuple");break;}
