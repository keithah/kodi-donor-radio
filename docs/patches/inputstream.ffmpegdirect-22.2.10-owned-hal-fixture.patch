+++ b/src/OwnedClockProtocol.h
@@ -0,0 +1,214 @@
+#pragma once
+// Controlled-fixture protocol only. No Kodi dependencies; lifecycle revocation is atomic.
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <limits>
+#include <sstream>
+#include <string>
+
+namespace owned_clock {
+struct StartupSeekState {
+  uint64_t acceptedFrames;
+  bool playbackStarted, decodeArmed, sourceTransferred, fixtureReady;
+};
+// Kodi VideoPlayerCodec probes capability (0,0x10), then backwards 1ms and 0ms.
+// This exception changes only clock eligibility, never the historical return,
+// demux calls or zero-rewind decode arming. One sequence is allowed per Open.
+class StartupSeekProbe {
+public:
+  bool Capability(int64_t position,int whence,const StartupSeekState& state) {
+    if(!Safe(state) || phase!=Fresh || position!=0 || whence!=0x10)return Reject();
+    phase=CapabilitySeen;return true;
+  }
+  bool Time(double time,bool backwards,const StartupSeekState& state) {
+    if(!Safe(state) || !backwards)return Reject();
+    if(phase==CapabilitySeen && time==1.0) {phase=OneMillisecondSeen;return true;}
+    if(phase==OneMillisecondSeen && time==0.0) {phase=Complete;return true;}
+    return Reject();
+  }
+private:
+  enum Phase { Fresh, CapabilitySeen, OneMillisecondSeen, Complete, Invalid };
+  Phase phase{Fresh};
+  bool Reject() {phase=Invalid;return false;}
+  static bool Safe(const StartupSeekState& state) {
+    return state.fixtureReady && state.acceptedFrames==0 && !state.playbackStarted &&
+        !state.decodeArmed && !state.sourceTransferred;
+  }
+};
+
+inline bool Hex(const std::string& s, size_t length) {
+  if (s.size() != length) return false;
+  for (char c : s) if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
+  return true;
+}
+inline bool Number(const std::string& s, uint64_t& value) {
+  if (s.empty() || s[0] == '0') return false;
+  value = 0;
+  for (char c : s) {
+    if (c < '0' || c > '9' || value > (std::numeric_limits<uint64_t>::max() - (c-'0')) / 10) return false;
+    value = value * 10 + (c-'0');
+  }
+  return true;
+}
+struct Command {
+  std::string nonce, incarnation, state;
+  unsigned revision{0};
+  uint64_t issued{0};
+};
+inline bool Parse(const std::string& line, Command& c) {
+  if (line.empty() || line.size() > 512 || line.back() != '\n') return false;
+  std::istringstream in(line);
+  std::string version, revision, issued;
+  Command parsed;
+  if (!(in >> version >> parsed.nonce >> parsed.incarnation >> revision >> parsed.state >> issued)) return false;
+  uint64_t r = 0;
+  if (version != "v1" || !Hex(parsed.nonce,32) || !Hex(parsed.incarnation,32) ||
+      !Number(revision,r) || r > 64 || !Number(issued,parsed.issued) ||
+      (parsed.state != "waiting" && parsed.state != "play" && parsed.state != "pause" &&
+       parsed.state != "resume" && parsed.state != "stop")) return false;
+  const std::string canonical = version + " " + parsed.nonce + " " + parsed.incarnation + " " +
+      revision + " " + parsed.state + " " + issued + "\n";
+  if (line != canonical) return false;
+  parsed.revision = static_cast<unsigned>(r);
+  c = parsed;
+  return true;
+}
+class Authority {
+public:
+  Authority(const std::string& nonce, const std::string& incarnation, uint64_t openNs = 0) : nonce(nonce), incarnation(incarnation), openNs(openNs) {}
+  // Called only by renderer. No callback waits for this acknowledgment.
+  bool Apply(const std::string& wire, uint64_t now) {
+    Command next;
+    if (!Parse(wire,next) || next.nonce != nonce || next.incarnation != incarnation || next.issued > now ||
+        (openNs && (next.revision == 1 ? next.issued > openNs : next.issued < openNs))) {
+      Revoke("command_invalid"); return false;
+    }
+    if (next.revision <= command.revision) {
+      if (records[next.revision-1] == wire) return true;
+      Revoke("command_conflict"); return false;
+    }
+    if (next.revision != command.revision+1 ||
+        (command.revision == 0 ? next.state != "waiting" :
+         next.state == "waiting" || next.issued <= command.issued || command.state == "stop") ||
+        (next.state == "play" && command.state != "waiting") ||
+        ((next.state == "pause" || next.state == "resume") && command.state == "waiting")) {
+      Revoke("command_sequence"); return false;
+    }
+    generation.fetch_add(1);
+    records[next.revision-1] = wire;
+    command = next;
+    applied = now;
+    if (next.state == "resume") resumedSpeedEpoch = speedEpoch.load();
+    if (next.state == "stop") Revoke("control_stop");
+    generation.fetch_add(1);
+    return true;
+  }
+  void Revoke(const char* why) {
+    const char* expected = nullptr;
+    if (reason.compare_exchange_strong(expected,why)) generation.fetch_add(1);
+  }
+  void Speed(int speed) {
+    mutations.fetch_add(1);
+    generation.fetch_add(1);
+    if (speed == 0) { speedEpoch.fetch_add(1); normalSpeed.store(false); }
+    else if (speed == 1000) normalSpeed.store(true);
+    else Revoke("abnormal_speed");
+    generation.fetch_add(1);
+    mutations.fetch_sub(1);
+  }
+  void ConfirmSource(bool valid) {
+    mutations.fetch_add(1);
+    generation.fetch_add(1);
+    if (!valid) Revoke("source_zero_mismatch");
+    sourceZero.store(valid);
+    generation.fetch_add(1);
+    mutations.fetch_sub(1);
+  }
+  bool Eligible(uint64_t before) const {
+    const bool valid = mutations.load() == 0 && !Retired() && sourceZero.load() && normalSpeed.load() &&
+        resumedSpeedEpoch == speedEpoch.load() &&
+        (command.state == "play" || command.state == "resume");
+    return valid && mutations.load() == 0 && before == generation.load();
+  }
+  uint64_t Generation() const { return generation.load(); }
+  bool Retired() const { return reason.load() != nullptr; }
+  const char* Reason() const {
+    const char* why = reason.load();
+    if (why) return why;
+    if (!sourceZero.load()) return "source_unconfirmed";
+    if (!normalSpeed.load() || resumedSpeedEpoch != speedEpoch.load()) return "speed_resume_required";
+    if (command.state != "play" && command.state != "resume") return "control_inactive";
+    return "eligible";
+  }
+  bool SourceZero() const { return sourceZero.load(); }
+  const Command& Control() const { return command; }
+  uint64_t Applied() const { return applied; }
+  void Acknowledge(uint64_t now) { applied = now; } // renderer: after applying the source feeder gate
+private:
+  const std::string nonce, incarnation;
+  const uint64_t openNs;
+  std::array<std::string,64> records;
+  Command command;
+  uint64_t applied{0}, resumedSpeedEpoch{0};
+  std::atomic<uint64_t> generation{1}, speedEpoch{0}, mutations{0};
+  std::atomic<bool> sourceZero{false}, normalSpeed{true};
+  std::atomic<const char*> reason{nullptr};
+};
+} // namespace owned_clock
+
+// Separate gain namespace for the opt-in HAL controls phase. Strict flat JSON:
+// no escaped identifiers, duplicate keys, nonfinite numbers, or implicit types.
+#include <map>
+#include <cstdlib>
+#include <cmath>
+namespace owned_clock {
+struct Gain {
+ std::string nonce,incarnation,timeline;
+ uint64_t revision=0,epoch=0,device=0,start=0,end=0,issue=0,expiry=0,volume=0;
+ bool muted=false;double multiplier=0;
+};
+inline bool GainNumber(const std::string& s,uint64_t& out) {
+ if(s=="0"){out=0;return true;}return Number(s,out);
+}
+inline bool GainJson(const std::string& line,std::map<std::string,std::string>& values,size_t limit=2048) {
+ if(line.size()<3||line.size()>limit||line.back()!='\n')return false;
+ size_t p=0;auto space=[&]{while(p<line.size()&&(line[p]==' '||line[p]=='\n'||line[p]=='\r'||line[p]=='\t'))++p;};
+ auto quoted=[&](std::string& out)->bool {
+  if(p>=line.size()||line[p++]!='"')return false;
+  const size_t begin=p;
+  while(p<line.size()&&line[p]!='"'){if(static_cast<unsigned char>(line[p])<32||line[p]=='\\')return false;++p;}
+  if(p==line.size())return false;out=line.substr(begin,p-begin);++p;return true;
+ };
+ space();if(p==line.size()||line[p++]!='{')return false;
+ while(true) {
+  space();std::string key,value;if(!quoted(key))return false;space();if(p==line.size()||line[p++]!=':')return false;space();
+  if(p<line.size()&&line[p]=='"'){std::string text;if(!quoted(text))return false;value="\""+text+"\"";}
+  else {const size_t begin=p;while(p<line.size()&&line[p]!=','&&line[p]!='}'&&line[p]!=' '&&line[p]!='\n'&&line[p]!='\r'&&line[p]!='\t')++p;value=line.substr(begin,p-begin);}
+  if(value.empty()||!values.emplace(key,value).second)return false;
+  space();if(p==line.size())return false;if(line[p]=='}'){++p;break;}if(line[p++]!=',')return false;
+ }
+ space();return p==line.size();
+}
+inline bool ParseGain(const std::string& wire,Gain& result) {
+ std::map<std::string,std::string> v;if(!GainJson(wire,v)||v.size()!=15)return false;
+ auto text=[&](const char* k,size_t size,std::string& out){auto i=v.find(k);if(i==v.end()||i->second.size()!=size+2||i->second.front()!='"'||i->second.back()!='"')return false;out=i->second.substr(1,size);return Hex(out,size);};
+ auto number=[&](const char* k,uint64_t& out){auto i=v.find(k);return i!=v.end()&&GainNumber(i->second,out);};
+ Gain g;uint64_t contract=0;
+ if(!text("nonce",32,g.nonce)||!text("incarnation",32,g.incarnation)||!text("timeline_sha256",64,g.timeline)||
+    v["output_backend"]!="\"hal_callback_v1\""||!number("hal_contract_version",contract)||contract!=1||
+    !number("device_generation",g.device)||!g.device||!number("revision",g.revision)||!g.revision||g.revision>6000||
+    !number("effective_epoch",g.epoch)||!g.epoch||!number("request_start_ns",g.start)||!number("request_end_ns",g.end)||
+    !number("issue_ns",g.issue)||!number("expiry_ns",g.expiry)||!number("volume",g.volume)||g.volume>100||
+    (v["muted"]!="true"&&v["muted"]!="false"))return false;
+ g.muted=v["muted"]=="true";const auto& m=v["multiplier"];if(m.empty()||m.front()=='+'||m.front()=='-'||m.front()=='.')return false;
+ // Decimal JSON grammar; strtod alone would also accept hex, infinity and NaN.
+ size_t i=0;if(m[i]=='0')++i;else{if(m[i]<'1'||m[i]>'9')return false;while(i<m.size()&&m[i]>='0'&&m[i]<='9')++i;}
+ if(i<m.size()&&m[i]=='.'){size_t b=++i;while(i<m.size()&&m[i]>='0'&&m[i]<='9')++i;if(i==b)return false;}
+ if(i<m.size()&&(m[i]=='e'||m[i]=='E')){++i;if(i<m.size()&&(m[i]=='+'||m[i]=='-'))++i;size_t b=i;while(i<m.size()&&m[i]>='0'&&m[i]<='9')++i;if(i==b)return false;}
+ if(i!=m.size())return false;char* tail=nullptr;g.multiplier=std::strtod(m.c_str(),&tail);
+ if(!tail||*tail||!std::isfinite(g.multiplier)||g.start>g.end||g.end-g.start>50000000||g.end>g.issue||
+    g.start>UINT64_MAX-500000000||g.expiry!=g.start+500000000||g.issue>g.expiry)return false;
+ result=g;return true;
+}
+}
