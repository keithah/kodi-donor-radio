+// Owner-only. For retained outcomes the original claim has never been released,
+// so idempotent quarantine cannot affect a newly admitted owner. This also
+// ensures a reported retained result has visible quarantine before return.
+CleanupResult ReportCleanup(HalRuntime& s,CleanupResult result)noexcept {
+  if(s.exposed||result!=CleanupResult::clean)ModuleGate().Quarantine();
+  else s.claimed=false;
+  return result;
+}
