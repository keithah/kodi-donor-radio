+template<class Atomic=std::atomic<uint64_t>> class BasicSourceQueue {
+public:
+  bool Ready()const noexcept {return read_.is_lock_free()&&write_.is_lock_free()&&end_.is_lock_free();}
+  bool Push(const float* data,uint32_t frames)noexcept {
+    if(!Ready()||!data||!frames||frames>kSourceCapacity||end_.load(std::memory_order_acquire)!=UINT64_MAX)return false;
+    const uint64_t w=write_.load(std::memory_order_relaxed),r=read_.load(std::memory_order_acquire);
