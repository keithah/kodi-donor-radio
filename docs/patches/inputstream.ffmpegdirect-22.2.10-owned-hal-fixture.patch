+      if(fd<0) {ownershipIntact=false;controlBarrier=i+1;continue;}
+      const bool pinnedOk=fstat(fd,&pinned)==0 && File(pinned) && Same(st,pinned);
+      const ssize_t n=pinnedOk?read(fd,bytes,sizeof(bytes)):-1;
+      struct stat after{}; const bool stable=fstat(fd,&after)==0 && Same(pinned,after);
+      close(fd);
+      if(!pinnedOk || !stable || n!=st.st_size) {ownershipIntact=false;controlBarrier=i+1;continue;}
+      Command command;
+      const std::string wire(bytes,static_cast<size_t>(n));
+      if(!Parse(wire,command) || command.revision!=i+1) {ownershipIntact=false;controlBarrier=i+1;continue;}
+      records[i]=st; seen[i]=true;pending.push_back(wire);
+    }
+    return ownershipIntact;
+  }
+
+  bool PollGain(uint64_t revision,std::vector<Gain>& pending) {
+    pending.clear();struct stat current{};
+    if(directory<0||revision>6000||lstat(path.c_str(),&current)!=0||current.st_dev!=identity.st_dev||
+       current.st_ino!=identity.st_ino||!S_ISDIR(current.st_mode)||(current.st_mode&0777)!=0700||current.st_uid!=geteuid())return false;
+    int fd=openat(directory,".",O_RDONLY|O_DIRECTORY|O_CLOEXEC);DIR* scan=fd>=0?fdopendir(fd):nullptr;
+    if(!scan){if(fd>=0)close(fd);return false;}
