+    while(dirent* entry=readdir(scan)) {
+      const std::string name(entry->d_name);if(name.compare(0,5,"gain-")!=0)continue;
+      if(name.size()!=16||name.substr(11)!=".json"){valid=false;continue;}
+      uint64_t n=0;bool digits=true;for(size_t i=5;i<11;++i){if(name[i]<'0'||name[i]>'9'){digits=false;break;}n=n*10+name[i]-'0';}
+      if(!digits||n==0||n>6000){valid=false;continue;}present[n-1]=true;
+    }
