+class ControlMailbox {
+public:
+  bool Ready()const noexcept {return published_.is_lock_free()&&consumed_.is_lock_free();}
+  Status TryOffer(const EffectiveControl& c)noexcept {
+    const uint64_t p=published_.load(std::memory_order_relaxed);
+    if(p!=consumed_.load(std::memory_order_acquire))return Status::busy;
+    if(p==UINT64_MAX)return Status::invalid;
