+bool InputStreamFFmpegDirect::WriteOwnedTelemetryLine(const std::string& line)
+{
+  // 180 seconds of 20 ms clock samples, up to 15 minutes of pause samples,
+  // packet records, and bounded startup/shutdown records fit under this cap.
+  constexpr size_t maxRows = 70000;
+  std::lock_guard<std::mutex> lock(m_ownedTelemetryMutex);
+  if (!m_ownedTelemetryFile.is_open() || m_ownedTelemetryRows >= maxRows)
+  {
+    m_ownedFailed = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: bounded HLS telemetry ledger unavailable or full");
+    return false;
+  }
+  m_ownedTelemetryFile << line << '\n';
+  m_ownedTelemetryFile.flush();
+  if (!m_ownedTelemetryFile)
+  {
+    m_ownedFailed = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: failed writing HLS telemetry ledger");
+    return false;
+  }
+  ++m_ownedTelemetryRows;
+  return true;
+}
+
+bool InputStreamFFmpegDirect::WriteOwnedPacketTelemetry(const DEMUX_PACKET* packet,
+                                                        bool packetIsAdts,
+                                                        size_t sourceFrameCount,
+                                                        uint64_t decodedStartFrame,
+                                                        uint64_t decodedEndFrame)
+{
+  if (!m_ownedHlsFixture || !packet)
+    return true;
+
+  double firstPts = STREAM_NOPTS_VALUE;
+  uint64_t epoch = 0;
+  uint64_t packetIndex = 0;
+  uint64_t decodedFrames = 0;
+  size_t queuedFrames = 0;
+  uint64_t acceptedFrames = 0;
+  uint64_t hostOutputFrames = 0;
+  double hostNextPts = 0.0;
+  bool hostPtsValid = false;
+  size_t syntheticHostFrames = 0;
+  {
+    std::lock_guard<std::mutex> lock(m_ownedMutex);
+    firstPts = m_ownedFirstSourcePts;
+    epoch = m_ownedSourceEpoch;
+    packetIndex = m_ownedSourcePacketCount;
+    decodedFrames = m_ownedTotalDecodedFrames;
+    queuedFrames = m_ownedQueuedFrames;
+    acceptedFrames = m_ownedAcceptedFrames.load();
+    hostOutputFrames = m_ownedHostOutputFrames;
+    hostNextPts = m_ownedHostNextPts;
+    hostPtsValid = m_ownedHostPtsValid;
+    syntheticHostFrames = m_ownedSyntheticFrames;
+  }
+
+  std::ostringstream line;
+  line << std::setprecision(17)
+       << "{\"kind\":\"source_packet\",\"packet_index\":" << packetIndex
+       << ",\"steady_ns\":" << SteadyNowNs()
+       << ",\"mach_absolute_ns\":" << MachAbsoluteNowNs()
+       << ",\"wall_utc_ns\":" << WallNowNs()
+       << ",\"format\":\"" << (packetIsAdts ? "adts" : "raw_aac") << "\""
+       << ",\"stream_id\":" << packet->iStreamId
+       << ",\"source_pts\":";
+  if (packet->pts == STREAM_NOPTS_VALUE)
+    line << "null";
+  else
+    line << packet->pts;
+  line << ",\"source_dts\":";
+  if (packet->dts == STREAM_NOPTS_VALUE)
+    line << "null";
+  else
+    line << packet->dts;
+  line << ",\"source_duration\":" << packet->duration
+       << ",\"first_source_pts\":";
+  if (firstPts == STREAM_NOPTS_VALUE)
+    line << "null";
+  else
+    line << firstPts;
+  line << ",\"source_epoch\":" << epoch
+       << ",\"source_access_units\":" << sourceFrameCount
+       << ",\"decoded_frame_start\":" << decodedStartFrame
+       << ",\"decoded_frame_end\":" << decodedEndFrame
+       << ",\"decoded_total_frames\":" << decodedFrames
+       << ",\"accepted_adddata_frames\":" << acceptedFrames
+       << ",\"queued_pcm_frames\":" << queuedFrames
+       << ",\"host_output_aac_access_units\":" << hostOutputFrames
+       << ",\"host_next_pts_valid\":" << (hostPtsValid ? "true" : "false")
+       << ",\"host_next_pts\":";
+  if (hostPtsValid && std::isfinite(hostNextPts))
+    line << hostNextPts;
+  else
+    line << "null";
+  line << ",\"synthetic_host_aac_access_units\":" << syntheticHostFrames
+       << ",\"source_pts_ticks_per_second\":" << STREAM_TIME_BASE
+       << ",\"host_pts_ticks_per_second\":" << STREAM_TIME_BASE << '}';
+  return WriteOwnedTelemetryLine(line.str());
+}
+
+void InputStreamFFmpegDirect::WriteOwnedClockTelemetry(const std::string& controlState)
+{
+  if (!m_ownedHlsFixture)
+    return;
+
+  const uint64_t sampleSteadyNs = SteadyNowNs();
+  const uint64_t sampleMachNs = MachAbsoluteNowNs();
+  const uint64_t sampleWallNs = WallNowNs();
+  const uint64_t cacheStartNs = SteadyNowNs();
+  const double cacheTime = m_ownedStream->GetCacheTime();
+  const uint64_t cacheEndNs = SteadyNowNs();
+  const uint64_t delayStartNs = SteadyNowNs();
+  const double delay = m_ownedStream->GetDelay();
+  const uint64_t delayEndNs = SteadyNowNs();
+
+  uint64_t packetIndex = 0;
+  uint64_t sourceEpoch = 0;
+  double firstPts = STREAM_NOPTS_VALUE;
+  double latestPts = STREAM_NOPTS_VALUE;
+  double latestDuration = 0.0;
+  uint64_t decodedFrames = 0;
+  size_t queuedFrames = 0;
+  uint64_t decodedStartFrame = 0;
+  uint64_t decodedEndFrame = 0;
+  uint64_t acceptedFrames = 0;
+  uint64_t hostOutputFrames = 0;
+  double hostNextPts = 0.0;
+  bool hostPtsValid = false;
+  size_t syntheticHostFrames = 0;
+  bool sourceEnded = false;
+  {
+    std::lock_guard<std::mutex> lock(m_ownedMutex);
+    packetIndex = m_ownedSourcePacketCount;
+    sourceEpoch = m_ownedSourceEpoch;
+    firstPts = m_ownedFirstSourcePts;
+    latestPts = m_ownedLastSourcePts;
+    latestDuration = m_ownedLastSourceDuration;
+    decodedFrames = m_ownedTotalDecodedFrames;
+    queuedFrames = m_ownedQueuedFrames;
+    decodedStartFrame = m_ownedLastPacketDecodedStartFrame;
+    decodedEndFrame = m_ownedLastPacketDecodedEndFrame;
+    acceptedFrames = m_ownedAcceptedFrames.load();
+    hostOutputFrames = m_ownedHostOutputFrames;
+    hostNextPts = m_ownedHostNextPts;
+    hostPtsValid = m_ownedHostPtsValid;
+    syntheticHostFrames = m_ownedSyntheticFrames;
+    sourceEnded = m_ownedSourceEnded;
+  }
+
+  std::ostringstream line;
+  line << std::setprecision(17)
+       << "{\"kind\":\"clock_sample\",\"control_state\":\"" << controlState << "\""
+       << ",\"steady_ns\":" << sampleSteadyNs
+       << ",\"mach_absolute_ns\":" << sampleMachNs
+       << ",\"wall_utc_ns\":" << sampleWallNs
+       << ",\"cache_query_start_steady_ns\":" << cacheStartNs
+       << ",\"cache_query_end_steady_ns\":" << cacheEndNs
+       << ",\"cache_time_s\":";
+  if (std::isfinite(cacheTime))
+    line << cacheTime;
+  else
+    line << "null";
+  line << ",\"delay_query_start_steady_ns\":" << delayStartNs
+       << ",\"delay_query_end_steady_ns\":" << delayEndNs
+       << ",\"audioengine_delay_s\":";
+  if (std::isfinite(delay))
+    line << delay;
+  else
+    line << "null";
+  line << ",\"playback_started\":" << (m_ownedPlaybackStarted.load() ? "true" : "false")
+       << ",\"source_ended\":" << (sourceEnded ? "true" : "false")
+       << ",\"drained\":" << (m_ownedDrained.load() ? "true" : "false")
+       << ",\"failed\":" << (m_ownedFailed.load() ? "true" : "false")
+       << ",\"packet_index\":" << packetIndex
+       << ",\"source_epoch\":" << sourceEpoch
+       << ",\"first_source_pts\":";
+  if (firstPts == STREAM_NOPTS_VALUE)
+    line << "null";
+  else
+    line << firstPts;
+  line << ",\"latest_source_pts\":";
+  if (latestPts == STREAM_NOPTS_VALUE)
+    line << "null";
+  else
+    line << latestPts;
+  line << ",\"latest_source_duration\":" << latestDuration
+       << ",\"latest_packet_decoded_frame_start\":" << decodedStartFrame
+       << ",\"latest_packet_decoded_frame_end\":" << decodedEndFrame
+       << ",\"decoded_total_frames\":" << decodedFrames
+       << ",\"accepted_adddata_frames\":" << acceptedFrames
+       << ",\"queued_pcm_frames\":" << queuedFrames
+       << ",\"host_output_aac_access_units\":" << hostOutputFrames
+       << ",\"host_next_pts_valid\":" << (hostPtsValid ? "true" : "false")
+       << ",\"host_next_pts\":";
+  if (hostPtsValid && std::isfinite(hostNextPts))
+    line << hostNextPts;
+  else
+    line << "null";
+  line << ",\"synthetic_host_aac_access_units\":" << syntheticHostFrames
+       << ",\"source_pts_ticks_per_second\":" << STREAM_TIME_BASE
+       << ",\"host_pts_ticks_per_second\":" << STREAM_TIME_BASE << '}';
+  WriteOwnedTelemetryLine(line.str());
+}
+
+bool InputStreamFFmpegDirect::FlushOwnedDecoder()
+{
+  std::lock_guard<std::mutex> lock(m_ownedMutex);
+  if (m_ownedDecoderFlushed)
+    return true;
+  if (!m_ownedRendererActive.load() || !m_ownedDecoder || !m_ownedDecodeFrame)
+    return false;
+
+  int result = avcodec_send_packet(m_ownedDecoder, nullptr);
+  if (result < 0 && result != AVERROR_EOF && result != AVERROR(EAGAIN))
+    return false;
+  while ((result = avcodec_receive_frame(m_ownedDecoder, m_ownedDecodeFrame)) == 0)
+  {
+    if (!AppendOwnedFrame(m_ownedDecodeFrame))
+    {
+      av_frame_unref(m_ownedDecodeFrame);
+      return false;
+    }
+    av_frame_unref(m_ownedDecodeFrame);
+  }
+  if (result != AVERROR_EOF && result != AVERROR(EAGAIN))
+    return false;
+  m_ownedDecoderFlushed = true;
+  m_ownedSourceEnded = true;
+  return true;
+}
+
+bool InputStreamFFmpegDirect::StartOwnedSourceReader()
+{
+  if (!m_ownedHlsFixture)
+    return true;
+
+  bool expected = false;
+  if (!m_ownedSourceOwnershipTransferred.compare_exchange_strong(expected, true))
+    return true;
+
+  try
+  {
+    m_ownedSourceThread = std::thread([this]() { RunOwnedSourceReader(); });
+  }
+  catch (const std::exception& error)
+  {
+    m_ownedFailed = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: could not start independent AAC source reader: %s",
+        error.what());
+    return false;
+  }
+
+  // Do not expose the first host packet until the independent source reader
+  // has buffered four seconds of decoded programme audio (or a finite source
+  // has ended with a shorter, non-empty programme). This wait occurs before
+  // Kodi sees its first packet, so it does not consume the AudioEngine startup
+  // readiness deadline.
+  const auto prefillDeadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+  while (!m_ownedInitialPrefillComplete.load() && !m_ownedFailed.load() &&
+         !m_ownedSourceStop.load() && std::chrono::steady_clock::now() < prefillDeadline)
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  if (!m_ownedInitialPrefillComplete.load())
+  {
+    m_ownedFailed = true;
+    m_ownedSourceStop = true;
+    Log(LOGLEVEL_ERROR,
+        "OWNED_RENDERER: independent AAC source did not reach its bounded startup prefill deadline");
+    return false;
+  }
+  Log(LOGLEVEL_INFO,
+      "OWNED_RENDERER: source-read ownership transferred after four-second decoded AAC prefill");
+  return true;
+}
+
+void InputStreamFFmpegDirect::RunOwnedSourceReader()
+{
+  constexpr size_t framesPerAacAccessUnit = 1024;
+  constexpr size_t startupHeadroomSeconds = 4;
+  const size_t startupHeadroomFrames = startupHeadroomSeconds * 48000;
+  DEMUX_PACKET* pendingPacket = nullptr;
+
+  auto readControlState = [] {
+    std::ifstream control(
+        "/private/tmp/kodi-audio-validation-20261027/native-pause-repair/owned-renderer/control");
+    std::string state;
+    if (control)
+      control >> state;
+    return state;
+  };
+
+  while (!m_ownedSourceStop.load())
+  {
+    const std::string state = readControlState();
+    if (state == "pause")
+    {
+      std::this_thread::sleep_for(std::chrono::milliseconds(5));
+      continue;
+    }
+
+    size_t queuedFrames = 0;
+    size_t queueCapacity = 0;
+    {
+      std::lock_guard<std::mutex> lock(m_ownedMutex);
+      queuedFrames = m_ownedQueuedFrames;
+      queueCapacity = m_ownedQueueCapacityFrames;
+    }
+    if (queueCapacity == 0 || queuedFrames > queueCapacity)
+    {
+      m_ownedFailed = true;
+      Log(LOGLEVEL_ERROR, "OWNED_RENDERER: source reader observed invalid bounded PCM queue state");
+      break;
+    }
+    if (queuedFrames >= startupHeadroomFrames)
+    {
+      // Keep four seconds queued to absorb the fixture's segmented HLS cadence.
+      // The source reader remains independent of Kodi's host DemuxRead calls.
+      std::this_thread::sleep_for(std::chrono::milliseconds(5));
+      continue;
+    }
+
+    if (!pendingPacket)
+      pendingPacket = m_stream ? m_stream->DemuxRead() : nullptr;
+
+    if (m_ownedSourceStop.load())
+      break;
+
+    if (!pendingPacket)
+    {
+      if (m_properties.m_terminalEof)
+      {
+        // Leave room for a final decoder-delay frame before flushing.
+        while (!m_ownedSourceStop.load())
+        {
+          size_t availableFrames = 0;
+          {
+            std::lock_guard<std::mutex> lock(m_ownedMutex);
+            if (m_ownedQueuedFrames <= m_ownedQueueCapacityFrames)
+              availableFrames = m_ownedQueueCapacityFrames - m_ownedQueuedFrames;
+          }
+          if (availableFrames >= framesPerAacAccessUnit)
+            break;
+          std::this_thread::sleep_for(std::chrono::milliseconds(5));
+        }
+        if (m_ownedSourceStop.load())
+          break;
+        if (!FlushOwnedDecoder())
+        {
+          m_ownedFailed = true;
+          Log(LOGLEVEL_ERROR, "OWNED_RENDERER: AAC decoder flush failed at finite HLS EOF");
+          break;
+        }
+        {
+          std::lock_guard<std::mutex> lock(m_ownedMutex);
+          if (m_ownedTotalDecodedFrames == 0)
+          {
+            m_ownedFailed = true;
+            Log(LOGLEVEL_ERROR,
+                "OWNED_RENDERER: finite HLS source ended before producing decoded programme audio");
+            break;
+          }
+          m_ownedInitialPrefillComplete = true;
+        }
+        Log(LOGLEVEL_INFO, "OWNED_RENDERER: independent HLS source reached terminal EOF");
+        break;
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(10));
+      continue;
+    }
+
+    const bool ordinaryTransientHlsEmpty =
+        pendingPacket->iSize == 0 && pendingPacket->iStreamId == -1 &&
+        pendingPacket->pData == nullptr && pendingPacket->pSideData == nullptr &&
+        pendingPacket->iSideDataElems == 0;
+    if (ordinaryTransientHlsEmpty)
+    {
+      FreeDemuxPacketFromInputStreamAPI(pendingPacket);
+      pendingPacket = nullptr;
+      std::this_thread::sleep_for(std::chrono::milliseconds(2));
+      continue;
+    }
+
+    if (pendingPacket->iSize <= 0 || !pendingPacket->pData ||
+        pendingPacket->iStreamId != m_ownedAudioStreamId)
+    {
+      Log(LOGLEVEL_ERROR,
+          "OWNED_RENDERER: unexpected stream/control packet in independent HLS source reader; aborting");
+      FreeDemuxPacketFromInputStreamAPI(pendingPacket);
+      pendingPacket = nullptr;
+      m_ownedFailed = true;
+      break;
+    }
+
+    bool isAdts = false;
+    size_t accessUnits = 0;
+    size_t offset = 0;
+    size_t firstFrameLength = 0;
+    isAdts = ParseAacLc48kStereoAdtsFrame(
+        pendingPacket->pData, static_cast<size_t>(pendingPacket->iSize), firstFrameLength);
+    if (isAdts)
+    {
+      while (offset < static_cast<size_t>(pendingPacket->iSize))
+      {
+        size_t frameLength = 0;
+        if (!ParseAacLc48kStereoAdtsFrame(
+                pendingPacket->pData + offset,
+                static_cast<size_t>(pendingPacket->iSize) - offset, frameLength))
+        {
+          break;
+        }
+        offset += frameLength;
+        ++accessUnits;
+      }
+      if (offset != static_cast<size_t>(pendingPacket->iSize))
+        accessUnits = 0;
+    }
+    else if (pendingPacket->iSize <= 8192)
+      accessUnits = 1;
+
+    if (accessUnits == 0 ||
+        accessUnits > std::numeric_limits<size_t>::max() / framesPerAacAccessUnit)
+    {
+      Log(LOGLEVEL_ERROR, "OWNED_RENDERER: HLS AAC source packet has invalid access-unit framing");
+      FreeDemuxPacketFromInputStreamAPI(pendingPacket);
+      pendingPacket = nullptr;
+      m_ownedFailed = true;
+      break;
+    }
+    const size_t requiredFrames = accessUnits * framesPerAacAccessUnit;
+    if (requiredFrames > queueCapacity)
+    {
+      Log(LOGLEVEL_ERROR, "OWNED_RENDERER: one HLS packet exceeds bounded PCM queue capacity");
+      FreeDemuxPacketFromInputStreamAPI(pendingPacket);
+      pendingPacket = nullptr;
+      m_ownedFailed = true;
+      break;
+    }
+
+    bool enoughSpace = false;
+    while (!m_ownedSourceStop.load())
+    {
+      {
+        std::lock_guard<std::mutex> lock(m_ownedMutex);
+        enoughSpace = m_ownedQueuedFrames <= m_ownedQueueCapacityFrames &&
+                      m_ownedQueueCapacityFrames - m_ownedQueuedFrames >= requiredFrames;
+      }
+      if (enoughSpace)
+        break;
+      std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+    if (m_ownedSourceStop.load())
+      break;
+
+    bool packetIsAdts = false;
+    size_t sourceFrameCount = 0;
+    uint64_t decodedStartFrame = 0;
+    uint64_t decodedEndFrame = 0;
+    if (!DecodeOwnedPacket(pendingPacket, packetIsAdts, sourceFrameCount,
+                           decodedStartFrame, decodedEndFrame) ||
+        !WriteOwnedPacketTelemetry(pendingPacket, packetIsAdts, sourceFrameCount,
+                                   decodedStartFrame, decodedEndFrame))
+    {
+      Log(LOGLEVEL_ERROR, "OWNED_RENDERER: independent AAC source decode or telemetry failed");
+      FreeDemuxPacketFromInputStreamAPI(pendingPacket);
+      pendingPacket = nullptr;
+      m_ownedFailed = true;
+      break;
+    }
+
+    {
+      std::lock_guard<std::mutex> lock(m_ownedMutex);
+      if (m_ownedQueuedFrames >= startupHeadroomFrames)
+        m_ownedInitialPrefillComplete = true;
+    }
+
+    FreeDemuxPacketFromInputStreamAPI(pendingPacket);
+    pendingPacket = nullptr;
+  }
+
+  if (pendingPacket)
+    FreeDemuxPacketFromInputStreamAPI(pendingPacket);
+}
+
+void InputStreamFFmpegDirect::RunOwnedRenderer()
+{
+  if (!m_ownedStream || m_ownedPcmQueue.empty())
+    return;
+
+  std::chrono::steady_clock::time_point readyDeadline{};
+  auto nextTelemetrySample = std::chrono::steady_clock::now();
+  bool readyDeadlineArmed = false;
+  std::string previousControl;
+  size_t acceptedFrames = 0;
+  while (!m_ownedStop.load())
+  {
+    std::ifstream control(
+        "/private/tmp/kodi-audio-validation-20261027/native-pause-repair/owned-renderer/control");
+    std::string state;
+    if (control)
+      control >> state;
+
+    // The addon monitor writes play from onAVStarted, after demux probing.
+    if ((state == "play" || state == "resume") && !readyDeadlineArmed)
+    {
+      m_ownedPlaybackStarted = true;
+      readyDeadlineArmed = true;
+      readyDeadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    }
+    const bool shouldFeed = m_ownedPlaybackStarted.load() &&
+                            (state == "play" || state == "resume") &&
+                            (!m_ownedHlsFixture || m_ownedInitialPrefillComplete.load());
+    if (state != previousControl)
+    {
+      uint64_t decodedFrames = 0;
+      size_t queuedFrames = 0;
+      {
+        std::lock_guard<std::mutex> lock(m_ownedMutex);
+        decodedFrames = m_ownedTotalDecodedFrames;
+        queuedFrames = m_ownedQueuedFrames;
+      }
+      Log(LOGLEVEL_INFO,
+          "OWNED_RENDERER: control state=%s accepted_cursor_frames=%zu decoded_frames=%llu queued_frames=%zu",
+          state.empty() ? "unset" : state.c_str(), acceptedFrames,
+          static_cast<unsigned long long>(decodedFrames), queuedFrames);
+      previousControl = state;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (m_ownedHlsFixture && now >= nextTelemetrySample)
+    {
+      WriteOwnedClockTelemetry(state.empty() ? "unset" : state);
+      do
+      {
+        nextTelemetrySample += std::chrono::milliseconds(20);
+      } while (nextTelemetrySample <= now);
+    }
+    if (m_ownedFailed.load())
+      return;
+
+    const size_t availableFrames = m_ownedStream->GetSpace() / (sizeof(float) * 2);
+    if (shouldFeed && availableFrames != 0)
+      m_ownedRendererReady = true;
+    else if (readyDeadlineArmed && !m_ownedRendererReady.load() &&
+             std::chrono::steady_clock::now() >= readyDeadline)
+    {
+      m_ownedFailed = true;
+      Log(LOGLEVEL_ERROR, "OWNED_RENDERER: Kodi audio stream did not become ready; aborting lab playback");
+      return;
+    }
+
+    bool sourceEnded = false;
+    if (shouldFeed && m_ownedRendererReady.load() && availableFrames != 0)
+    {
+      std::lock_guard<std::mutex> lock(m_ownedMutex);
+      if (m_ownedQueuedFrames != 0)
+      {
+        const size_t contiguousFrames = m_ownedQueueCapacityFrames - m_ownedQueueReadFrame;
+        const size_t frames = std::min({size_t{1024}, availableFrames,
+                                        m_ownedQueuedFrames, contiguousFrames});
+        uint8_t* planes[] = {reinterpret_cast<uint8_t*>(m_ownedPcmQueue.data())};
+        const unsigned int consumed = m_ownedStream->AddData(
+            planes, static_cast<unsigned int>(m_ownedQueueReadFrame),
+            static_cast<unsigned int>(frames));
+        m_ownedQueueReadFrame = (m_ownedQueueReadFrame + consumed) % m_ownedQueueCapacityFrames;
+        m_ownedQueuedFrames -= consumed;
+        acceptedFrames += consumed;
+        m_ownedAcceptedFrames.store(acceptedFrames);
+      }
+    }
+
+    {
+      std::lock_guard<std::mutex> lock(m_ownedMutex);
+      sourceEnded = m_ownedSourceEnded && m_ownedQueuedFrames == 0;
+      if (sourceEnded && !m_ownedDrainStarted.load())
+      {
+        m_ownedStream->Drain(false);
+        m_ownedDrainStarted.store(true);
+        Log(LOGLEVEL_INFO,
+            "OWNED_RENDERER: decoded source ended; waiting for AudioEngine drain; decoded_frames=%llu accepted_cursor_frames=%zu",
+            static_cast<unsigned long long>(m_ownedTotalDecodedFrames), acceptedFrames);
+      }
+    }
+    if (m_ownedDrainStarted.load() && m_ownedStream->IsDrained())
+    {
+      m_ownedDrained = true;
+      WriteOwnedClockTelemetry("drained");
+      uint64_t decodedFrames = 0;
+      {
+        std::lock_guard<std::mutex> lock(m_ownedMutex);
+        decodedFrames = m_ownedTotalDecodedFrames;
+      }
+      Log(LOGLEVEL_INFO,
+          "OWNED_RENDERER: decoded source drained; decoded_frames=%llu accepted_cursor_frames=%zu",
+          static_cast<unsigned long long>(decodedFrames), acceptedFrames);
+      return;
+    }
+
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+}
+
+void InputStreamFFmpegDirect::StopOwnedRenderer()
+{
+  // The source worker owns m_stream->DemuxRead after the first anchored packet.
+  // Join it before closing or mutating that source and before decoder teardown.
+  m_ownedSourceStop = true;
+  if (m_ownedSourceThread.joinable())
+    m_ownedSourceThread.join();
+
+  m_ownedRendererReady = false;
+  m_ownedStop = true;
+  if (m_ownedThread.joinable())
+    m_ownedThread.join();
+  m_ownedRendererActive = false;
+  m_ownedStream.reset();
+  {
+    std::lock_guard<std::mutex> lock(m_ownedMutex);
+    if (m_ownedDecodeFrame)
+      av_frame_free(&m_ownedDecodeFrame);
+    if (m_ownedDecoder)
+      avcodec_free_context(&m_ownedDecoder);
+    m_ownedPcmQueue.clear();
+    m_ownedQueueCapacityFrames = 0;
+    m_ownedQueuedFrames = 0;
+    m_ownedQueueReadFrame = 0;
+    m_ownedQueueWriteFrame = 0;
+    m_silenceAdtsFrame.clear();
+    m_silenceRawAacFrame.clear();
+  }
+  {
+    std::lock_guard<std::mutex> lock(m_ownedTelemetryMutex);
+    if (m_ownedTelemetryFile.is_open())
+    {
+      m_ownedTelemetryFile.flush();
+      m_ownedTelemetryFile.close();
+    }
+  }
+}
+
+bool InputStreamFFmpegDirect::OwnedPlaybackStarted()
+{
+  if (m_ownedPlaybackStarted.load())
+    return true;
+  std::ifstream control(
+      "/private/tmp/kodi-audio-validation-20261027/native-pause-repair/owned-renderer/control");
+  std::string state;
+  if (control)
+    control >> state;
+  if (state == "play" || state == "resume")
+    m_ownedPlaybackStarted = true;
+  return m_ownedPlaybackStarted.load();
+}
+
+void InputStreamFFmpegDirect::ResetOwnedTimeline()
+{
+  std::lock_guard<std::mutex> lock(m_ownedMutex);
+  if (m_ownedDecoder)
+    avcodec_flush_buffers(m_ownedDecoder);
+  m_ownedQueueReadFrame = 0;
+  m_ownedQueueWriteFrame = 0;
+  m_ownedQueuedFrames = 0;
+  m_ownedTotalDecodedFrames = 0;
+  m_ownedSyntheticFrames = 0;
+  m_ownedHostOutputFrames = 0;
+  m_ownedAcceptedFrames = 0;
+  m_ownedSourcePacketCount = 0;
+  m_ownedHasFirstSourcePts = false;
+  m_ownedFirstSourcePts = STREAM_NOPTS_VALUE;
+  m_ownedHasLastSourcePts = false;
+  m_ownedLastSourcePts = STREAM_NOPTS_VALUE;
+  m_ownedLastSourceDuration = 0.0;
+  m_ownedSourceEpoch = 0;
+  m_ownedLastPacketDecodedStartFrame = 0;
+  m_ownedLastPacketDecodedEndFrame = 0;
+  m_ownedInputFormatKnown = false;
+  m_ownedInputUsesAdts = false;
+  m_ownedNextPts = 0.0;
+  m_ownedPtsValid = false;
+  m_ownedHostNextPts = 0.0;
+  m_ownedHostPtsValid = false;
+  m_ownedSourceEnded = false;
+  m_ownedDecoderFlushed = false;
+  m_ownedDrainStarted.store(false);
+  m_ownedSourceOwnershipTransferred = false;
+  m_ownedInitialPrefillComplete = false;
+  m_ownedHostTimeMs = 0;
+  m_ownedDrained = false;
+  m_ownedFailed = false;
