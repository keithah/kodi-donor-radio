+  packet->iSize = static_cast<int>(silenceFrame.size());
+  packet->iStreamId = streamId;
+  packet->demuxerId = demuxerId;
+  packet->iGroupId = 0;
+  packet->pSideData = nullptr;
+  packet->iSideDataElems = 0;
+  packet->pts = pts;
+  packet->dts = pts;
+  packet->duration = m_ownedFrameDuration;
+  packet->dispTime = -1;
+  packet->recoveryPoint = false;
+  packet->cryptoInfo = nullptr;
+  return packet;
+}
