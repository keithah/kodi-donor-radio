+bool InputStreamFFmpegDirect::DecodeOwnedAacPacket(const uint8_t* data, size_t size)
+{
+  AVPacket* packet = av_packet_alloc();
+  if (!packet || size > static_cast<size_t>(std::numeric_limits<int>::max()) ||
+      av_new_packet(packet, static_cast<int>(size)) < 0)
+  {
+    av_packet_free(&packet);
+    return false;
+  }
+  std::memcpy(packet->data, data, size);
+
+  int result = avcodec_send_packet(m_ownedDecoder, packet);
+  if (result == AVERROR(EAGAIN))
+  {
+    av_packet_free(&packet);
+    while ((result = avcodec_receive_frame(m_ownedDecoder, m_ownedDecodeFrame)) == 0)
+    {
+      if (!AppendOwnedFrame(m_ownedDecodeFrame))
+      {
+        av_frame_unref(m_ownedDecodeFrame);
+        return false;
+      }
+      av_frame_unref(m_ownedDecodeFrame);
+    }
+    if (result != AVERROR(EAGAIN) && result != AVERROR_EOF)
+      return false;
+    packet = av_packet_alloc();
+    if (!packet || av_new_packet(packet, static_cast<int>(size)) < 0)
+    {
+      av_packet_free(&packet);
+      return false;
+    }
+    std::memcpy(packet->data, data, size);
+    result = avcodec_send_packet(m_ownedDecoder, packet);
+  }
+  av_packet_free(&packet);
+  if (result < 0)
+    return false;
+
+  while ((result = avcodec_receive_frame(m_ownedDecoder, m_ownedDecodeFrame)) == 0)
+  {
+    if (!AppendOwnedFrame(m_ownedDecodeFrame))
+    {
+      av_frame_unref(m_ownedDecodeFrame);
+      return false;
+    }
+    av_frame_unref(m_ownedDecodeFrame);
+  }
+  return result == AVERROR(EAGAIN) || result == AVERROR_EOF;
+}
+
+bool InputStreamFFmpegDirect::AppendOwnedFrame(const AVFrame* frame)
+{
+  if (!frame || frame->sample_rate != 48000 || frame->ch_layout.nb_channels != 2 ||
+      (frame->format != AV_SAMPLE_FMT_FLTP && frame->format != AV_SAMPLE_FMT_FLT) ||
+      frame->nb_samples < 0 || !frame->extended_data || !frame->extended_data[0] ||
+      (frame->format == AV_SAMPLE_FMT_FLTP && !frame->extended_data[1]) ||
+      m_ownedQueueCapacityFrames == 0)
+    return false;
+
+  const size_t frames = static_cast<size_t>(frame->nb_samples);
+  if (frames > m_ownedQueueCapacityFrames - m_ownedQueuedFrames ||
+      static_cast<uint64_t>(frames) >
+          std::numeric_limits<uint64_t>::max() - m_ownedTotalDecodedFrames)
+    return false;
+
+  const float* left = reinterpret_cast<const float*>(frame->extended_data[0]);
+  const float* right = frame->format == AV_SAMPLE_FMT_FLTP
+                           ? reinterpret_cast<const float*>(frame->extended_data[1])
+                           : nullptr;
+  for (size_t i = 0; i < frames; ++i)
+  {
+    const size_t write = (m_ownedQueueWriteFrame + i) % m_ownedQueueCapacityFrames;
+    if (right)
+    {
+      m_ownedPcmQueue[write * 2] = left[i];
+      m_ownedPcmQueue[write * 2 + 1] = right[i];
+    }
+    else
+    {
+      m_ownedPcmQueue[write * 2] = left[i * 2];
+      m_ownedPcmQueue[write * 2 + 1] = left[i * 2 + 1];
+    }
+  }
+  m_ownedQueueWriteFrame = (m_ownedQueueWriteFrame + frames) % m_ownedQueueCapacityFrames;
+  m_ownedQueuedFrames += frames;
+  m_ownedTotalDecodedFrames += static_cast<uint64_t>(frames);
+  return true;
+}
+
+bool InputStreamFFmpegDirect::DecodeOwnedPacket(const DEMUX_PACKET* packet,
+                                                bool& packetIsAdts,
+                                                size_t& sourceFrameCount,
+                                                uint64_t& decodedStartFrame,
+                                                uint64_t& decodedEndFrame)
+{
+  if (!packet || !packet->pData || packet->iSize <= 0 ||
+      packet->iStreamId != m_ownedAudioStreamId)
+    return false;
+
+  std::lock_guard<std::mutex> lock(m_ownedMutex);
+  if (!m_ownedRendererActive.load() || !m_ownedDecoder || !m_ownedDecodeFrame)
+    return false;
+
+  decodedStartFrame = m_ownedTotalDecodedFrames;
+  size_t offset = 0;
+  sourceFrameCount = 0;
+  size_t firstFrameLength = 0;
+  packetIsAdts = ParseAacLc48kStereoAdtsFrame(
+      packet->pData, static_cast<size_t>(packet->iSize), firstFrameLength);
+  if (packetIsAdts)
+  {
+    while (offset < static_cast<size_t>(packet->iSize))
+    {
+      size_t frameLength = 0;
+      if (!ParseAacLc48kStereoAdtsFrame(packet->pData + offset,
+                                        static_cast<size_t>(packet->iSize) - offset,
+                                        frameLength) ||
+          !DecodeOwnedAacPacket(packet->pData + offset, frameLength))
+        return false;
+      offset += frameLength;
+      ++sourceFrameCount;
+    }
+    if (sourceFrameCount == 0 || offset != static_cast<size_t>(packet->iSize))
+      return false;
+  }
+  else
+  {
+    constexpr size_t maxRawAccessUnitBytes = 8192;
+    constexpr double accessUnitDurationSeconds = 1024.0 / 48000.0;
+    if (!m_ownedHlsFixture || packet->iSize > static_cast<int>(maxRawAccessUnitBytes) ||
+        m_ownedDecoder->extradata_size <= 0 ||
+        (packet->duration > 0 &&
+         std::abs(static_cast<double>(packet->duration) / STREAM_TIME_BASE -
+                  accessUnitDurationSeconds) > 0.002) ||
+        !DecodeOwnedAacPacket(packet->pData, static_cast<size_t>(packet->iSize)))
+      return false;
+
+    sourceFrameCount = 1;
+    const uint64_t decodedByPacket = m_ownedTotalDecodedFrames - decodedStartFrame;
+    if (decodedByPacket != 0 && decodedByPacket != 1024)
+      return false;
+  }
+
+  if (m_ownedInputFormatKnown && m_ownedInputUsesAdts != packetIsAdts)
+    return false;
+  m_ownedInputFormatKnown = true;
+  m_ownedInputUsesAdts = packetIsAdts;
+  decodedEndFrame = m_ownedTotalDecodedFrames;
+  m_ownedLastPacketDecodedStartFrame = decodedStartFrame;
+  m_ownedLastPacketDecodedEndFrame = decodedEndFrame;
+  ++m_ownedSourcePacketCount;
+
+  if (packet->pts != STREAM_NOPTS_VALUE)
+  {
+    if (!m_ownedHasFirstSourcePts)
+    {
+      m_ownedHasFirstSourcePts = true;
+      m_ownedFirstSourcePts = packet->pts;
+    }
+    if (m_ownedHasLastSourcePts)
+    {
+      const double delta = packet->pts - m_ownedLastSourcePts;
+      const double expectedDuration = packet->duration > 0
+                                          ? static_cast<double>(packet->duration)
+                                          : m_ownedFrameDuration * sourceFrameCount;
+      const double discontinuityThreshold =
+          std::max(STREAM_SEC_TO_TIME(0.5), expectedDuration * 3.0);
+      if (delta < -STREAM_SEC_TO_TIME(0.05) || delta > discontinuityThreshold)
+        ++m_ownedSourceEpoch;
+    }
+    m_ownedHasLastSourcePts = true;
+    m_ownedLastSourcePts = packet->pts;
+  }
+  m_ownedLastSourceDuration = packet->duration;
+
+  m_ownedDemuxerId = packet->demuxerId;
+  if (m_ownedHlsFixture && packet->pts == STREAM_NOPTS_VALUE)
+    return false;
+  if (packet->pts != STREAM_NOPTS_VALUE)
+  {
+    m_ownedPtsValid = true;
+    m_ownedNextPts = packet->pts +
+                     (packet->duration > 0 ? packet->duration
+                                           : m_ownedFrameDuration * sourceFrameCount);
+  }
+  return true;
+}
