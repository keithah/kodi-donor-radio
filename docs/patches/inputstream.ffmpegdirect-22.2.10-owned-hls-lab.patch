+        m_ownedInputFormatKnown && !m_ownedInputUsesAdts ? m_silenceRawAacFrame
+                                                         : m_silenceAdtsFrame;
+    if (!m_ownedRendererActive.load() || m_ownedDrained.load())
+      return nullptr;
+    const double nextPts = hlsHostTimeline ? m_ownedHostNextPts : m_ownedNextPts;
+    const bool ptsValid = hlsHostTimeline ? m_ownedHostPtsValid : m_ownedPtsValid;
+    if (!ptsValid || !std::isfinite(nextPts) ||
+        (!hlsHostTimeline && m_ownedSyntheticFrames >= maxSyntheticFrames) ||
+        m_ownedSyntheticFrames == std::numeric_limits<size_t>::max() ||
+        m_ownedAudioStreamId < 0 || selectedSilenceFrame.empty())
+    {
+      m_ownedFailed = true;
