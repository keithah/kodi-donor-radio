+bool InputStreamFFmpegDirect::DecodeOwnedAdtsFrame(const uint8_t* data, size_t size)
+{
+  AVPacket* packet = av_packet_alloc();
+  if (!packet || size > static_cast<size_t>(std::numeric_limits<int>::max()) ||
+      av_new_packet(packet, static_cast<int>(size)) < 0)
+  {
+    av_packet_free(&packet);
+    return false;
+  }
+  std::memcpy(packet->data, data, size);
+
+  int result = avcodec_send_packet(m_ownedDecoder, packet);
+  if (result == AVERROR(EAGAIN))
+  {
+    av_packet_free(&packet);
+    while ((result = avcodec_receive_frame(m_ownedDecoder, m_ownedDecodeFrame)) == 0)
+    {
+      if (!AppendOwnedFrame(m_ownedDecodeFrame))
+      {
+        av_frame_unref(m_ownedDecodeFrame);
+        return false;
+      }
+      av_frame_unref(m_ownedDecodeFrame);
+    }
+    if (result != AVERROR(EAGAIN) && result != AVERROR_EOF)
+      return false;
+    packet = av_packet_alloc();
+    if (!packet || av_new_packet(packet, static_cast<int>(size)) < 0)
+    {
+      av_packet_free(&packet);
+      return false;
+    }
+    std::memcpy(packet->data, data, size);
+    result = avcodec_send_packet(m_ownedDecoder, packet);
+  }
+  av_packet_free(&packet);
+  if (result < 0)
+    return false;
+
+  while ((result = avcodec_receive_frame(m_ownedDecoder, m_ownedDecodeFrame)) == 0)
+  {
+    if (!AppendOwnedFrame(m_ownedDecodeFrame))
+    {
+      av_frame_unref(m_ownedDecodeFrame);
+      return false;
+    }
+    av_frame_unref(m_ownedDecodeFrame);
+  }
+  return result == AVERROR(EAGAIN) || result == AVERROR_EOF;
+}
+
+bool InputStreamFFmpegDirect::AppendOwnedFrame(const AVFrame* frame)
+{
+  if (!frame || frame->sample_rate != 48000 || frame->ch_layout.nb_channels != 2 ||
+      (frame->format != AV_SAMPLE_FMT_FLTP && frame->format != AV_SAMPLE_FMT_FLT) ||
+      frame->nb_samples < 0 || !frame->extended_data || !frame->extended_data[0] ||
+      (frame->format == AV_SAMPLE_FMT_FLTP && !frame->extended_data[1]) ||
+      m_ownedQueueCapacityFrames == 0)
+    return false;
+
+  const size_t frames = static_cast<size_t>(frame->nb_samples);
+  constexpr size_t maxTotalFrames = 64 * 48000;
+  if (frames > m_ownedQueueCapacityFrames - m_ownedQueuedFrames ||
+      frames > maxTotalFrames - m_ownedTotalDecodedFrames)
+    return false;
+
+  const float* left = reinterpret_cast<const float*>(frame->extended_data[0]);
+  const float* right = frame->format == AV_SAMPLE_FMT_FLTP
+                           ? reinterpret_cast<const float*>(frame->extended_data[1])
+                           : nullptr;
+  for (size_t i = 0; i < frames; ++i)
+  {
+    const size_t write = (m_ownedQueueWriteFrame + i) % m_ownedQueueCapacityFrames;
+    if (right)
+    {
+      m_ownedPcmQueue[write * 2] = left[i];
+      m_ownedPcmQueue[write * 2 + 1] = right[i];
+    }
+    else
+    {
+      m_ownedPcmQueue[write * 2] = left[i * 2];
+      m_ownedPcmQueue[write * 2 + 1] = left[i * 2 + 1];
+    }
+  }
+  m_ownedQueueWriteFrame = (m_ownedQueueWriteFrame + frames) % m_ownedQueueCapacityFrames;
+  m_ownedQueuedFrames += frames;
+  m_ownedTotalDecodedFrames += frames;
+  return true;
+}
+
+bool InputStreamFFmpegDirect::DecodeOwnedPacket(const DEMUX_PACKET* packet)
+{
+  if (!packet || !packet->pData || packet->iSize <= 0 ||
+      packet->iStreamId != m_ownedAudioStreamId)
+    return false;
+
+  std::lock_guard<std::mutex> lock(m_ownedMutex);
+  if (!m_ownedRendererActive.load() || !m_ownedDecoder || !m_ownedDecodeFrame)
+    return false;
+  size_t offset = 0;
+  size_t frameCount = 0;
+  while (offset < static_cast<size_t>(packet->iSize))
+  {
+    size_t frameLength = 0;
+    if (!ParseAacLc48kStereoAdtsFrame(packet->pData + offset,
+                                      static_cast<size_t>(packet->iSize) - offset,
+                                      frameLength) ||
+        !DecodeOwnedAdtsFrame(packet->pData + offset, frameLength))
+      return false;
+    offset += frameLength;
+    ++frameCount;
+  }
+  if (frameCount == 0 || offset != static_cast<size_t>(packet->iSize))
+    return false;
+
+  m_ownedDemuxerId = packet->demuxerId;
+  if (packet->pts != STREAM_NOPTS_VALUE)
+  {
+    m_ownedPtsValid = true;
+    m_ownedNextPts = packet->pts +
+                     (packet->duration > 0 ? packet->duration
+                                           : m_ownedFrameDuration * frameCount);
+  }
+  return true;
+}
+
+bool InputStreamFFmpegDirect::FlushOwnedDecoder()
+{
+  std::lock_guard<std::mutex> lock(m_ownedMutex);
+  if (m_ownedDecoderFlushed)
+    return true;
+  if (!m_ownedRendererActive.load() || !m_ownedDecoder || !m_ownedDecodeFrame)
+    return false;
+
+  int result = avcodec_send_packet(m_ownedDecoder, nullptr);
+  if (result < 0 && result != AVERROR_EOF && result != AVERROR(EAGAIN))
+    return false;
+  while ((result = avcodec_receive_frame(m_ownedDecoder, m_ownedDecodeFrame)) == 0)
+  {
+    if (!AppendOwnedFrame(m_ownedDecodeFrame))
+    {
+      av_frame_unref(m_ownedDecodeFrame);
+      return false;
+    }
+    av_frame_unref(m_ownedDecodeFrame);
+  }
+  if (result != AVERROR_EOF && result != AVERROR(EAGAIN))
+    return false;
+  m_ownedDecoderFlushed = true;
+  m_ownedSourceEnded = true;
+  return true;
+}
+
+void InputStreamFFmpegDirect::RunOwnedRenderer()
+{
+  if (!m_ownedStream || m_ownedPcmQueue.empty())
+    return;
+
+  std::chrono::steady_clock::time_point readyDeadline{};
+  bool readyDeadlineArmed = false;
+  std::string previousControl;
+  size_t acceptedFrames = 0;
+  while (!m_ownedStop.load())
+  {
+    std::ifstream control(
+        "/private/tmp/kodi-audio-validation-20261027/native-pause-repair/owned-renderer/control");
+    std::string state;
+    if (control)
+      control >> state;
+
+    // The addon monitor writes play from onAVStarted, after demux probing.
+    if ((state == "play" || state == "resume") && !readyDeadlineArmed)
+    {
+      m_ownedPlaybackStarted = true;
+      readyDeadlineArmed = true;
+      readyDeadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    }
+    const bool shouldFeed = m_ownedPlaybackStarted.load() &&
+                            (state == "play" || state == "resume");
+    if (state != previousControl)
+    {
+      size_t decodedFrames = 0;
+      size_t queuedFrames = 0;
+      {
+        std::lock_guard<std::mutex> lock(m_ownedMutex);
+        decodedFrames = m_ownedTotalDecodedFrames;
+        queuedFrames = m_ownedQueuedFrames;
+      }
+      Log(LOGLEVEL_INFO,
+          "OWNED_RENDERER: control state=%s accepted_cursor_frames=%zu decoded_frames=%zu queued_frames=%zu",
+          state.empty() ? "unset" : state.c_str(), acceptedFrames, decodedFrames, queuedFrames);
+      previousControl = state;
+    }
+    if (m_ownedFailed.load())
+      return;
+
+    const size_t availableFrames = m_ownedStream->GetSpace() / (sizeof(float) * 2);
+    if (shouldFeed && availableFrames != 0)
+      m_ownedRendererReady = true;
+    else if (readyDeadlineArmed && !m_ownedRendererReady.load() &&
+             std::chrono::steady_clock::now() >= readyDeadline)
+    {
+      m_ownedFailed = true;
+      Log(LOGLEVEL_ERROR, "OWNED_RENDERER: Kodi audio stream did not become ready; aborting lab playback");
+      return;
+    }
+
+    bool sourceEnded = false;
+    if (shouldFeed && m_ownedRendererReady.load() && availableFrames != 0)
+    {
+      std::lock_guard<std::mutex> lock(m_ownedMutex);
+      if (m_ownedQueuedFrames != 0)
+      {
+        const size_t contiguousFrames = m_ownedQueueCapacityFrames - m_ownedQueueReadFrame;
+        const size_t frames = std::min({size_t{1024}, availableFrames,
+                                        m_ownedQueuedFrames, contiguousFrames});
+        uint8_t* planes[] = {reinterpret_cast<uint8_t*>(m_ownedPcmQueue.data())};
+        const unsigned int consumed = m_ownedStream->AddData(
+            planes, static_cast<unsigned int>(m_ownedQueueReadFrame),
+            static_cast<unsigned int>(frames));
+        m_ownedQueueReadFrame = (m_ownedQueueReadFrame + consumed) % m_ownedQueueCapacityFrames;
+        m_ownedQueuedFrames -= consumed;
+        acceptedFrames += consumed;
+      }
+    }
+
+    {
+      std::lock_guard<std::mutex> lock(m_ownedMutex);
+      sourceEnded = m_ownedSourceEnded && m_ownedQueuedFrames == 0;
+      if (sourceEnded && !m_ownedDrainStarted.load())
+      {
+        m_ownedStream->Drain(false);
+        m_ownedDrainStarted.store(true);
+        Log(LOGLEVEL_INFO,
+            "OWNED_RENDERER: decoded source ended; waiting for AudioEngine drain; decoded_frames=%zu accepted_cursor_frames=%zu",
+            m_ownedTotalDecodedFrames, acceptedFrames);
+      }
+    }
+    if (m_ownedDrainStarted.load() && m_ownedStream->IsDrained())
+    {
+      m_ownedDrained = true;
+      size_t decodedFrames = 0;
+      {
+        std::lock_guard<std::mutex> lock(m_ownedMutex);
+        decodedFrames = m_ownedTotalDecodedFrames;
+      }
+      Log(LOGLEVEL_INFO,
+          "OWNED_RENDERER: decoded source drained; decoded_frames=%zu accepted_cursor_frames=%zu",
+          decodedFrames, acceptedFrames);
+      return;
+    }
+
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+}
+
+void InputStreamFFmpegDirect::StopOwnedRenderer()
+{
+  m_ownedRendererActive = false;
+  m_ownedRendererReady = false;
+  m_ownedStop = true;
+  if (m_ownedThread.joinable())
+    m_ownedThread.join();
+  m_ownedStream.reset();
+  std::lock_guard<std::mutex> lock(m_ownedMutex);
+  if (m_ownedDecodeFrame)
+    av_frame_free(&m_ownedDecodeFrame);
+  if (m_ownedDecoder)
+    avcodec_free_context(&m_ownedDecoder);
+  m_ownedPcmQueue.clear();
+  m_ownedQueueCapacityFrames = 0;
+  m_ownedQueuedFrames = 0;
+  m_ownedQueueReadFrame = 0;
+  m_ownedQueueWriteFrame = 0;
+  m_silenceAdtsFrame.clear();
+}
+
+bool InputStreamFFmpegDirect::OwnedPlaybackStarted()
+{
+  if (m_ownedPlaybackStarted.load())
+    return true;
+  std::ifstream control(
+      "/private/tmp/kodi-audio-validation-20261027/native-pause-repair/owned-renderer/control");
+  std::string state;
+  if (control)
+    control >> state;
+  if (state == "play" || state == "resume")
+    m_ownedPlaybackStarted = true;
+  return m_ownedPlaybackStarted.load();
+}
+
+void InputStreamFFmpegDirect::ResetOwnedTimeline()
+{
+  std::lock_guard<std::mutex> lock(m_ownedMutex);
+  if (m_ownedDecoder)
+    avcodec_flush_buffers(m_ownedDecoder);
+  m_ownedQueueReadFrame = 0;
+  m_ownedQueueWriteFrame = 0;
+  m_ownedQueuedFrames = 0;
+  m_ownedTotalDecodedFrames = 0;
+  m_ownedSyntheticFrames = 0;
+  m_ownedNextPts = 0.0;
+  m_ownedPtsValid = false;
+  m_ownedSourceEnded = false;
+  m_ownedDecoderFlushed = false;
+  m_ownedDrainStarted.store(false);
+  m_ownedDrained = false;
+  m_ownedFailed = false;
+}
+
+DEMUX_PACKET* InputStreamFFmpegDirect::MakeOwnedSilentPacket()
+{
+  std::lock_guard<std::mutex> lock(m_ownedMutex);
+  constexpr size_t maxSyntheticFrames = (64 * 48000) / 1024;
+  if (!m_ownedRendererActive.load() || m_ownedDrained.load())
+    return nullptr;
+  if (!m_ownedPtsValid || !std::isfinite(m_ownedNextPts) ||
+      m_ownedSyntheticFrames >= maxSyntheticFrames || m_ownedAudioStreamId < 0 ||
+      m_silenceAdtsFrame.empty())
+  {
+    m_ownedFailed = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: cannot maintain finite silent AAC tail; aborting lab playback");
+    return nullptr;
+  }
+
+  DEMUX_PACKET* packet = AllocateDemuxPacketFromInputStreamAPI(
+      static_cast<int>(m_silenceAdtsFrame.size()));
+  if (!packet)
+  {
+    m_ownedFailed = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: could not allocate silent AAC tail packet");
+    return nullptr;
+  }
+  std::memcpy(packet->pData, m_silenceAdtsFrame.data(), m_silenceAdtsFrame.size());
+  packet->iSize = static_cast<int>(m_silenceAdtsFrame.size());
+  packet->iStreamId = m_ownedAudioStreamId;
+  packet->demuxerId = m_ownedDemuxerId;
+  packet->iGroupId = 0;
+  packet->pSideData = nullptr;
+  packet->iSideDataElems = 0;
+  packet->pts = m_ownedNextPts;
+  packet->dts = m_ownedNextPts;
+  packet->duration = m_ownedFrameDuration;
+  packet->dispTime = -1;
+  packet->recoveryPoint = false;
+  packet->cryptoInfo = nullptr;
+  m_ownedNextPts += m_ownedFrameDuration;
+  ++m_ownedSyntheticFrames;
+  return packet;
+}
