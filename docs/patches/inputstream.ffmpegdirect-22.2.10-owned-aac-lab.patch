+      info.GetSampleRate() != 48000 || info.GetChannels() != 2)
+  {
+    m_ownedFailed = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: stream format changed outside the controlled AAC fixture");
+    FreeDemuxPacketFromInputStreamAPI(packet);
+    return nullptr;
+  }
+
+  if (!DecodeOwnedPacket(packet))
+  {
+    m_ownedFailed = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: packet decode or bounded PCM queue failed; aborting lab playback");
+    FreeDemuxPacketFromInputStreamAPI(packet);
+    return nullptr;
+  }
+  if (!m_ownedRendererActive.load())
+  {
+    FreeDemuxPacketFromInputStreamAPI(packet);
+    return nullptr;
+  }
+
+  size_t sourceOffset = 0;
+  size_t sourceFrameCount = 0;
+  while (sourceOffset < static_cast<size_t>(packet->iSize))
+  {
+    size_t sourceFrameLength = 0;
+    if (!ParseAacLc48kStereoAdtsFrame(packet->pData + sourceOffset,
+                                     static_cast<size_t>(packet->iSize) - sourceOffset,
+                                     sourceFrameLength))
+      break;
+    sourceOffset += sourceFrameLength;
+    ++sourceFrameCount;
+  }
+
+  const size_t replacementBytes = sourceFrameCount * m_silenceAdtsFrame.size();
+  if (sourceOffset != static_cast<size_t>(packet->iSize) || sourceFrameCount == 0 ||
+      replacementBytes > static_cast<size_t>(packet->iSize))
+  {
+    m_ownedFailed = true;
+    Log(LOGLEVEL_ERROR, "OWNED_RENDERER: source packet is not replaceable AAC-LC ADTS; aborting lab playback");
+    FreeDemuxPacketFromInputStreamAPI(packet);
+    return nullptr;
+  }
+
+  std::lock_guard<std::mutex> lock(m_ownedMutex);
+  if (m_silenceAdtsFrame.empty())
+  {
+    FreeDemuxPacketFromInputStreamAPI(packet);
+    return nullptr;
+  }
+  for (size_t frame = 0; frame < sourceFrameCount; ++frame)
+    std::memcpy(packet->pData + frame * m_silenceAdtsFrame.size(), m_silenceAdtsFrame.data(),
+                m_silenceAdtsFrame.size());
+  packet->iSize = static_cast<int>(replacementBytes);
+  return packet;
 }
 
