+bool InputStreamFFmpegDirect::StartOwnedRenderer()
+{
+  constexpr size_t frameBytes = sizeof(float) * 2;
+  constexpr size_t maxSeconds = 64;
+  const std::string root =
+      "/private/tmp/kodi-audio-validation-20261027/native-pause-repair/owned-renderer/";
+
+  auto* ffmpegStream = dynamic_cast<ffmpegdirect::FFmpegStream*>(m_stream.get());
+  if (!ffmpegStream || !ffmpegStream->m_pFormatContext)
+  {
+    Log(LOGLEVEL_WARNING, "OWNED_RENDERER: FFmpeg format context unavailable");
+    return false;
+  }
+
+  AVStream* audioStream = nullptr;
+  for (unsigned int index = 0; index < ffmpegStream->m_pFormatContext->nb_streams; ++index)
+  {
+    AVStream* candidate = ffmpegStream->m_pFormatContext->streams[index];
+    const AVCodecParameters* parameters = candidate ? candidate->codecpar : nullptr;
+    if (parameters && parameters->codec_type == AVMEDIA_TYPE_AUDIO &&
+        parameters->codec_id == AV_CODEC_ID_AAC)
+    {
+      audioStream = candidate;
+      m_ownedAudioStreamId = static_cast<int>(index);
+      break;
+    }
+  }
+  if (!audioStream || audioStream->codecpar->sample_rate != 48000 ||
+      audioStream->codecpar->ch_layout.nb_channels != 2 ||
+      (audioStream->codecpar->profile != AV_PROFILE_UNKNOWN &&
+       audioStream->codecpar->profile != AV_PROFILE_AAC_LOW))
+  {
+    Log(LOGLEVEL_WARNING, "OWNED_RENDERER: source is not controlled AAC-LC 48 kHz stereo");
+    return false;
+  }
+
+  const AVCodec* decoder = avcodec_find_decoder(AV_CODEC_ID_AAC);
+  m_ownedDecoder = decoder ? avcodec_alloc_context3(decoder) : nullptr;
+  if (!m_ownedDecoder ||
+      avcodec_parameters_to_context(m_ownedDecoder, audioStream->codecpar) < 0)
+  {
+    if (m_ownedDecoder)
+      avcodec_free_context(&m_ownedDecoder);
+    Log(LOGLEVEL_WARNING, "OWNED_RENDERER: could not initialize AAC decoder parameters");
+    return false;
+  }
+  m_ownedDecoder->pkt_timebase = audioStream->time_base;
+  m_ownedDecoder->thread_count = 1;
+  if (avcodec_open2(m_ownedDecoder, decoder, nullptr) < 0)
+  {
+    avcodec_free_context(&m_ownedDecoder);
+    Log(LOGLEVEL_WARNING, "OWNED_RENDERER: could not open AAC decoder");
+    return false;
+  }
+  m_ownedDecodeFrame = av_frame_alloc();
+  if (!m_ownedDecodeFrame)
+  {
+    avcodec_free_context(&m_ownedDecoder);
+    Log(LOGLEVEL_WARNING, "OWNED_RENDERER: could not allocate AAC decode frame");
+    return false;
+  }
+
+  std::ifstream silence(root + "silence-frame.aac", std::ios::binary | std::ios::ate);
+  if (!silence || silence.tellg() != 13)
+  {
+    av_frame_free(&m_ownedDecodeFrame);
+    avcodec_free_context(&m_ownedDecoder);
+    Log(LOGLEVEL_WARNING, "OWNED_RENDERER: one-frame AAC silence fixture must be 13 bytes");
+    return false;
+  }
+  m_silenceAdtsFrame.resize(13);
+  silence.seekg(0);
+  silence.read(reinterpret_cast<char*>(m_silenceAdtsFrame.data()), 13);
+  size_t silenceLength = 0;
+  if (silence.gcount() != 13 ||
+      !ParseAacLc48kStereoAdtsFrame(m_silenceAdtsFrame.data(), m_silenceAdtsFrame.size(),
+                                    silenceLength) ||
+      silenceLength != m_silenceAdtsFrame.size())
+  {
+    m_silenceAdtsFrame.clear();
+    av_frame_free(&m_ownedDecodeFrame);
+    avcodec_free_context(&m_ownedDecoder);
+    Log(LOGLEVEL_WARNING, "OWNED_RENDERER: invalid single-frame ADTS silence fixture");
+    return false;
+  }
+
+  m_ownedQueueCapacityFrames = 48000 * maxSeconds;
+  m_ownedPcmQueue.assign(m_ownedQueueCapacityFrames * 2, 0.0f);
+  m_ownedQueueReadFrame = 0;
+  m_ownedQueueWriteFrame = 0;
+  m_ownedQueuedFrames = 0;
+  m_ownedTotalDecodedFrames = 0;
+  m_ownedSyntheticFrames = 0;
+  m_ownedNextPts = 0.0;
+  m_ownedPtsValid = false;
+  m_ownedFrameDuration = STREAM_SEC_TO_TIME(1024.0 / 48000.0);
+  m_ownedDecodeArmed = false;
+  m_ownedSourceEnded = false;
+  m_ownedDecoderFlushed = false;
+  m_ownedDrainStarted.store(false);
+  m_ownedDemuxerId = 0;
+
+  kodi::audioengine::AudioEngineFormat format;
+  format.SetDataFormat(AUDIOENGINE_FMT_FLOAT);
+  format.SetSampleRate(48000);
+  format.SetChannelLayout({AUDIOENGINE_CH_FL, AUDIOENGINE_CH_FR});
+  format.SetFrameSize(frameBytes);
+  format.SetFramesAmount(1024);
+  m_ownedStream = std::make_unique<kodi::audioengine::CAEStream>(format, AUDIO_STREAM_AUTOSTART);
+  m_ownedStop = false;
+  m_ownedRendererReady = false;
+  m_ownedPlaybackStarted = false;
+  m_ownedDrained = false;
+  m_ownedFailed = false;
+  m_ownedRendererActive = true;
+  m_ownedThread = std::thread([this]() { RunOwnedRenderer(); });
+  Log(LOGLEVEL_INFO, "OWNED_RENDERER: AAC packet decoder enabled for exact loopback fixture; queue capped at 64 seconds");
+  return true;
+}
