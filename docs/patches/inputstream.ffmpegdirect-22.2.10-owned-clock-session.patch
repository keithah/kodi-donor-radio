+constexpr uint64_t MaxFrames=uint64_t(std::numeric_limits<int>::max())*48;
+inline bool ValidCursor(uint64_t frames) { return frames<=MaxFrames-Frames; }
+template<class Info> bool Project(const Info& source,Info& host,bool enabled) {
+  if(!enabled || source.GetStreamType()!=INPUTSTREAM_TYPE_AUDIO || source.GetCodecName()!="aac" ||
+     source.GetSampleRate()!=Rate || source.GetChannels()!=2)return false;
+  host=source;
