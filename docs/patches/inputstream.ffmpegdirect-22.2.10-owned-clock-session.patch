+#pragma once
+// Explicit fixture host contract. No Kodi symbols or target-thread handles.
+#include <cstdint>
+#include <mutex>
+#include <string>
+namespace owned_player {
+inline bool VerifiedPacket(int bytes,int stream,int expectedStream,double pts,bool adts,
+                           const std::string& expectedHash,const std::string& digest) {
+ return bytes>0 && bytes<=8192 && stream==expectedStream && pts==0.0 && !adts &&
+     expectedHash.size()==64 && digest==expectedHash;
+}
+struct Snapshot {
+ std::string mode{"paplayer_pcm_v1"}, core{"PAPlayer"};
+ uint64_t generation{1}, caller{0}, observed{0};
+ bool armed{false}, retired{false};
+};
+struct Proof {
+ bool fresh,normal,metadata,raw,hash;
+ uint64_t accepted,decoded,queued,packets;
+ double pts;
+};
+class State {
+ mutable std::mutex mutex;Snapshot state;bool video{false},videoControl{false},attempted{false};
+public:
+ bool Configure(const std::string& mode,const std::string& core,const std::string& queue="") {
+  std::lock_guard<std::mutex> lock(mutex);state=Snapshot{};attempted=false;
+  videoControl=mode=="videoplayer_video_v1";
+  video=mode=="videoplayer_pcm_v1" || videoControl;
+  if((videoControl && queue!="40") || (!videoControl && !queue.empty())){state.retired=true;return false;}
+  if((mode.empty() && core.empty()) || (mode=="paplayer_pcm_v1" && core=="PAPlayer"))return true;
+  if(video && core=="VideoPlayer") {state.mode=mode;state.core=core;return true;}
+  state.retired=true;return false;
+ }
+ bool VideoControl() const {return videoControl;}
+ bool Video() const {return video;} // immutable between Open and all worker joins
+ Snapshot Get() const {std::lock_guard<std::mutex> lock(mutex);return state;}
+ void Retire() {std::lock_guard<std::mutex> lock(mutex);if(!state.retired){state.retired=true;++state.generation;}}
+ bool Observe(uint64_t caller,int identity,const std::string& name,int nameStatus,uint64_t now) {
+  std::lock_guard<std::mutex> lock(mutex);
+  if(state.retired)return false;
+  if(!video || !caller || identity || nameStatus || name!="VideoPlayer" || !now || (state.caller && state.caller!=caller)) {
+   state.retired=true;++state.generation;return false;
+  }
+  if(!state.caller){state.caller=caller;state.observed=now;++state.generation;}
+  return true;
+ }
+ template<class Decode> bool Arm(const Proof& p,Decode decode) {
+  {
+   std::lock_guard<std::mutex> lock(mutex);
+   if(state.retired)return false;
+   if(!video || !state.caller || attempted || !p.fresh || !p.normal || !p.metadata || !p.raw || !p.hash ||
+      p.accepted || p.decoded || p.queued || p.packets || p.pts!=0.0) {
+    state.retired=true;++state.generation;return false;
+   }
+   attempted=true;++state.generation;
+  }
+  const bool ok=decode(); // same retained packet, one call; never hold lock into addon code
+  std::lock_guard<std::mutex> lock(mutex);
+  if(!ok || state.retired){state.retired=true;++state.generation;return false;}
+  state.armed=true;++state.generation;return true;
+ }
+};
