+namespace owned_clock {
+class Transport {
+public:
+  ~Transport() { Close(); }
+  void Close() {
+    if (ledger >= 0) close(ledger);
+    if (directory >= 0) close(directory);
+    ledger = directory = -1;
+  }
+  static bool Same(const struct stat& a,const struct stat& b) {
+    return a.st_dev == b.st_dev && a.st_ino == b.st_ino && a.st_size == b.st_size &&
+        a.st_mtimespec.tv_sec == b.st_mtimespec.tv_sec && a.st_mtimespec.tv_nsec == b.st_mtimespec.tv_nsec &&
+        a.st_ctimespec.tv_sec == b.st_ctimespec.tv_sec && a.st_ctimespec.tv_nsec == b.st_ctimespec.tv_nsec;
+  }
+  static bool File(const struct stat& st) {
+    return S_ISREG(st.st_mode) && st.st_uid == geteuid() && (st.st_mode&0777)==0600 && st.st_nlink==1;
+  }
+  static int Pin(const std::string& path) {
+    if (path.empty() || path.front() != '/') return -1;
+    int fd = open("/",O_RDONLY|O_DIRECTORY|O_CLOEXEC);
+    std::istringstream components(path.substr(1)); std::string component;
+    while (std::getline(components,component,'/')) {
+      if (component.empty() || component=="." || component=="..") { close(fd); return -1; }
+      int child = openat(fd,component.c_str(),O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+      close(fd); fd=child; if (fd<0) return -1;
+      struct stat st{};
+      if (fstat(fd,&st)!=0 || !S_ISDIR(st.st_mode) || (st.st_uid!=0 && st.st_uid!=geteuid()) ||
+          ((st.st_mode&0022) && !(st.st_uid==0 && (st.st_mode&S_ISVTX)))) {close(fd);return -1;}
+    }
+    struct stat st{};
+    if (fd<0 || fstat(fd,&st)!=0 || st.st_uid!=geteuid() || (st.st_mode&0777)!=0700) {
+      if(fd>=0) close(fd); return -1;
+    }
+    return fd;
+  }
+  bool Open(const std::string& path,const std::string& hello) {
+    if (directory>=0 || hello.size()>2048) return false;
+    directory=Pin(path); if(directory<0) return false;
+    this->path=path;
+    if(fstat(directory,&identity)!=0) {Close();return false;}
+    ledger=openat(directory,"native.jsonl",O_WRONLY|O_CREAT|O_EXCL|O_APPEND|O_NOFOLLOW|O_CLOEXEC,0600);
+    if(ledger<0 || fchmod(ledger,0600)!=0 || fstat(ledger,&ledgerIdentity)!=0) {Close();return false;}
+    int fd=openat(directory,".native-hello.tmp",O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);
+    if(fd<0) {Close();return false;}
+    const bool helloOk=fchmod(fd,0600)==0 && Write(fd,hello);
+    close(fd);
+    // The immutable handshake becomes visible only when complete and ledger-ready.
+    // RENAME_EXCL preserves collision rejection without a link-count race for readers.
+    if(!helloOk || renameatx_np(directory,".native-hello.tmp",directory,"hello.json",RENAME_EXCL)!=0 ||
+       fstatat(directory,"hello.json",&helloIdentity,AT_SYMLINK_NOFOLLOW)!=0 || !File(helloIdentity)) {
+      Close();return false;
+    }
+    return true;
+  }
+  bool Append(const std::string& line) {
+    struct stat current{};
+    if(ledger<0 || line.size()>16383 || fstatat(directory,"native.jsonl",&current,AT_SYMLINK_NOFOLLOW)!=0 ||
+       !File(current) || current.st_dev!=ledgerIdentity.st_dev || current.st_ino!=ledgerIdentity.st_ino ||
+       current.st_size!=ledgerBytes) return false;
+    if(!Write(ledger,line+"\n")) return false;
+    ledgerBytes+=line.size()+1; return true;
+  }
+  // The result is permanent evidence validity, not permission to use pending.
+  // Even after retirement, pending contains only individually validated exact-next
+  // controls from the original pinned directory. Never discard a safe prefix.
+  bool Poll(unsigned revision,std::vector<std::string>& pending) {
+    pending.clear();
+    struct stat current{};
+    if(directory<0 || lstat(path.c_str(),&current)!=0 || !S_ISDIR(current.st_mode) ||
+       current.st_dev!=identity.st_dev || current.st_ino!=identity.st_ino ||
+       current.st_uid!=geteuid() || (current.st_mode&0777)!=0700 || revision>64)
+      return ownershipIntact=false;
+    struct stat hello{};
+    if(fstatat(directory,"hello.json",&hello,AT_SYMLINK_NOFOLLOW)!=0 || !File(hello) || !Same(hello,helloIdentity))
+      ownershipIntact=false;
+    int scanFd=openat(directory,".",O_RDONLY|O_DIRECTORY|O_CLOEXEC);
+    DIR* scan=scanFd>=0?fdopendir(scanFd):nullptr;
+    if(!scan) {if(scanFd>=0)close(scanFd);return ownershipIntact=false;}
+    std::array<bool,64> present{};
+    errno=0;
+    while (dirent* entry=readdir(scan)) {
+      const std::string name(entry->d_name);
+      if(name.compare(0,8,"command-")!=0) continue;
+      if(name.size()!=18 || name.substr(14)!=".txt") {ownershipIntact=false;continue;}
+      unsigned n=0; bool canonical=true;
+      for(size_t i=8;i<14;++i) {
+        if(name[i]<'0'||name[i]>'9') {canonical=false;break;}
+        n=n*10+name[i]-'0';
+      }
+      if(!canonical || n==0 || n>64) {ownershipIntact=false;continue;}
+      present[n-1]=true;
+    }
+    const bool scanComplete=errno==0;
+    closedir(scan);
+    if(!scanComplete)return ownershipIntact=false;
+    unsigned firstMissing=65;
+    for(unsigned i=0;i<64;++i) {
+      if(!present[i]) {
+        if(i<revision) ownershipIntact=false; // Old evidence cannot veto a new pause.
+        else if(firstMissing==65) firstMissing=i+1;
+        continue;
+      }
+      if(i>=revision && firstMissing!=65) {
+        ownershipIntact=false;
+        if(firstMissing<controlBarrier)controlBarrier=firstMissing;
+      }
+      char name[32];std::snprintf(name,sizeof(name),"command-%06u.txt",i+1);
+      struct stat st{};
+      if(fstatat(directory,name,&st,AT_SYMLINK_NOFOLLOW)!=0 || !File(st) ||
+         st.st_size<=0 || st.st_size>512 || (seen[i] && !Same(st,records[i]))) {
+        ownershipIntact=false;
+        if(i>=revision && i+1<controlBarrier)controlBarrier=i+1;
+        continue;
+      }
+      if(i<revision || i+1>=controlBarrier || pending.size()>=8)continue;
+      int fd=openat(directory,name,O_RDONLY|O_NOFOLLOW|O_CLOEXEC|O_NONBLOCK);
+      struct stat pinned{}; char bytes[513];
+      if(fd<0) {ownershipIntact=false;controlBarrier=i+1;continue;}
+      const bool pinnedOk=fstat(fd,&pinned)==0 && File(pinned) && Same(st,pinned);
+      const ssize_t n=pinnedOk?read(fd,bytes,sizeof(bytes)):-1;
+      struct stat after{}; const bool stable=fstat(fd,&after)==0 && Same(pinned,after);
+      close(fd);
+      if(!pinnedOk || !stable || n!=st.st_size) {ownershipIntact=false;controlBarrier=i+1;continue;}
+      Command command;
+      const std::string wire(bytes,static_cast<size_t>(n));
+      if(!Parse(wire,command) || command.revision!=i+1) {ownershipIntact=false;controlBarrier=i+1;continue;}
+      records[i]=st; seen[i]=true;pending.push_back(wire);
+    }
+    return ownershipIntact;
+  }
+
+private:
+  static bool Write(int fd,const std::string& bytes) {
+    size_t offset=0;
+    while(offset<bytes.size()) {
+      const ssize_t n=write(fd,bytes.data()+offset,bytes.size()-offset);
+      if(n<0 && errno==EINTR)continue;
+      if(n<=0)return false;
+      offset+=static_cast<size_t>(n);
+    }
+    return true;
+  }
+  int directory{-1},ledger{-1};
+  off_t ledgerBytes{0};
+  bool ownershipIntact{true};
+  unsigned controlBarrier{65}; // An invalid unacknowledged revision is never skipped or repaired.
+  std::string path;
+  struct stat identity{},ledgerIdentity{},helloIdentity{};
+  std::array<struct stat,64> records{};
+  std::array<bool,64> seen{};
+};
