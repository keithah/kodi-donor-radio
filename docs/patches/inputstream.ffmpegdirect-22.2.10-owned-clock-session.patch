+  void* token=nullptr;
+  bool nativePaused=false,releasePending=false;
+  uint64_t lastSuspendedNs=0;
+};
+template<class Function> class OnExit {
+ public:
+  explicit OnExit(Function function):function(std::move(function)) {}
+  ~OnExit() { function(); }
+  OnExit(const OnExit&)=delete;
+  OnExit& operator=(const OnExit&)=delete;
+ private: Function function;
+};
+inline void WriteJson(std::ostream& out,const Snapshot& s,uint64_t before) {
+  out << "{\"version\":1,\"enabled\":" << (s.enabled ? "true":"false")
+      << ",\"active\":" << (s.active ? "true":"false") << ",\"allowed\":" << (s.allowed ? "true":"false")
+      << ",\"failed\":" << (s.failed ? "true":"false") << ",\"terminal\":" << (s.terminal ? "true":"false")
+      << ",\"owner_running\":" << (s.ownerRunning ? "true":"false")
+      << ",\"generation_before\":" << before << ",\"generation_after\":" << s.generation << ",\"control_revision\":" << s.revision
+      << ",\"owner_id\":" << s.ownerId << ",\"target_id\":" << s.targetId
+      << ",\"target_name\":\"" << (s.targetId ? "PAPlayer":"") << "\",\"requested_class\":25,\"requested_relative_priority\":0"
+      << ",\"start_attempts\":" << s.startAttempts << ",\"starts\":" << s.starts
+      << ",\"end_attempts\":" << s.endAttempts << ",\"ends\":" << s.ends
+      << ",\"ignored_preparation\":" << s.ignoredPreparation << ",\"blocked_through_revision\":" << s.blockedThrough
+      << ",\"outstanding\":" << s.outstanding << ",\"max_outstanding\":" << s.maxOutstanding
+      << ",\"last_start_mach_ns\":" << s.lastStartNs << ",\"last_end_mach_ns\":" << s.lastEndNs
+      << ",\"last_end_owner_id\":" << s.lastEndOwner << ",\"last_start_status\":" << s.lastStartStatus
+      << ",\"last_end_status\":" << s.lastEndStatus << ",\"reason\":\"" << s.reason << "\"}";
+}
