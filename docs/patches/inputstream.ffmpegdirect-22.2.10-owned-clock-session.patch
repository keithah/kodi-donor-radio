+#pragma once
+// Fixture-only control video. No audio data or clock estimation lives here.
+#include <kodi/c-api/addon-instance/inputstream.h>
+#include <cstdint>
+#include <cstddef>
+#include <cstring>
+#include <limits>
+#include <ostream>
+#include <vector>
+namespace owned_video {
+constexpr size_t Bytes=384;
+constexpr uint64_t StartupNs=30000000000ULL,HoldNs=1000000000ULL,TotalSamples=8641536;
+constexpr uint64_t SamplesPerFrame=4800,LeadFrames=60;
+template<class Info> bool Project(const Info& source,Info& host) {
+ if(source.GetStreamType()!=INPUTSTREAM_TYPE_AUDIO || source.GetCodecName()!="aac" ||
+    source.GetSampleRate()!=48000 || source.GetChannels()!=2)return false;
+ host=Info{};host.SetStreamType(INPUTSTREAM_TYPE_VIDEO);
+ // Kodi DVDDemuxClient gates rawvideo on nonempty extradata. FFmpeg ignores this one-byte marker.
+ // SetExtraData owns the vector; original AAC bytes remain separate.
+ host.SetExtraData(std::vector<uint8_t>{0});
+ host.SetCodecName("rawvideo");host.SetCodecInternalName("rawvideo");
+ host.SetCodecProfile(CodecProfileNotNeeded);host.SetCodecFourCC(0x30323449);
+ host.SetWidth(16);host.SetHeight(16);host.SetAspect(1.0f);host.SetFpsRate(10);host.SetFpsScale(1);
+ host.SetBitRate(30720);host.SetColorSpace(INPUTSTREAM_COLORSPACE_BT709);host.SetColorRange(INPUTSTREAM_COLORRANGE_LIMITED);
+ return true;
+}
+enum class Result { Frame,Retry,End,Error };
+struct Snapshot {
+ uint64_t openNs=0,startDeadline=0,startAckNs=0,drainNs=0,holdDeadline=0,eofNs=0,lastFrameNs=0,frames=0;
+ bool armed=false,drained=false,closed=false,failed=false;
+};
+class Timeline {
+ Snapshot s;bool pending=false;
+ bool Fail() {s.failed=true;s.closed=true;pending=false;return false;}
+public:
+ Snapshot Get()const{return s;}
+ bool Open(uint64_t now) {
+  s=Snapshot{};pending=false;
+  if(!now || now>std::numeric_limits<uint64_t>::max()-StartupNs)return Fail();
+  s.openNs=now;s.startDeadline=now+StartupNs;return true;
+ }
+ bool Arm() {if(!s.openNs || s.closed || s.armed)return Fail();s.armed=true;return true;}
+ bool Expired(uint64_t now)const {return !s.startAckNs && (now<s.openNs || now>=s.startDeadline);}
+ bool AcknowledgeStart(uint64_t now) {
+  if(s.closed || !s.armed || now<s.openNs || Expired(now))return Fail();
+  if(!s.startAckNs)s.startAckNs=now;
+  return true;
+ }
+ bool Drain(uint64_t now) {
+  if(s.drained)return !s.failed;
+  if(s.closed || !s.armed || !s.startAckNs || now<s.openNs || now>std::numeric_limits<uint64_t>::max()-HoldNs)return Fail();
+  s.drained=true;s.drainNs=now;s.holdDeadline=now+HoldNs;pending=false;return true;
+ }
+ void Close(uint64_t now) {s.closed=true;pending=false;if(!s.eofNs)s.eofNs=now;}
+ Result Next(uint64_t now,uint64_t accepted,bool cancel) {
+  pending=false;
+  if(cancel){Close(now);return Result::End;}
+  if(s.closed)return s.failed ? Result::Error : Result::End;
+  if(!s.armed || now<s.openNs || Expired(now) || accepted>TotalSamples){Fail();return Result::Error;}
+  if(s.drained){if(now<s.holdDeadline)return Result::Retry;Close(now);return Result::End;}
+  if(s.frames>=accepted/SamplesPerFrame+LeadFrames)return Result::Retry;
+  pending=true;return Result::Frame;
+ }
+ bool Fill(uint8_t* payload,size_t size,uint64_t now,double& pts,double& duration) {
+  if(s.closed || s.drained || !pending || !payload || size!=Bytes || now<s.openNs)return Fail();
+  pending=false;pts=static_cast<double>(s.frames)*100000.0;duration=100000.0;
