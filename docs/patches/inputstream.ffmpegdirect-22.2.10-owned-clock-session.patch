+    }
+    struct stat st{};
+    if (fd<0 || fstat(fd,&st)!=0 || st.st_uid!=geteuid() || (st.st_mode&0777)!=0700) {
+      if(fd>=0) close(fd); return -1;
+    }
+    return fd;
+  }
