--- a/src/OwnedStallDiagnostics.h
+++ b/src/OwnedStallDiagnostics.h
@@ -0,0 +1,96 @@
+#pragma once
+// Diagnostic only: fixed storage, no IO, no waiting for instrumentation locks.
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <ostream>
+
+namespace owned_stall {
+enum Operation : size_t {
+  ControlRead, TelemetryWait, TelemetryWrite, TelemetryFlush,
+  RendererOwnedWait, ClockOwnedWait, HostOwnedWait, AddData,
+  SleepOvershoot, HostPacketInterarrival, HostPacketCall, RendererLoop, GetSpace, DecodeOwnedWait, DecodeOwnedHeld, PacketOwnedWait, Count
+};
+static constexpr const char* Names[] = {
+  "control_read", "telemetry_mutex_wait", "telemetry_write", "telemetry_flush",
+  "renderer_owned_mutex_wait", "clock_owned_mutex_wait", "host_owned_mutex_wait",
+  "adddata", "renderer_sleep_overshoot", "host_packet_interarrival", "host_packet_call", "renderer_loop", "getspace", "decode_owned_mutex_wait", "decode_owned_mutex_held", "packet_owned_mutex_wait"
+};
+struct Metric {
+  uint64_t count{0}, maxNs{0}, maxStartNs{0}, maxEndNs{0};
+};
+struct Event { size_t operation{0}; uint64_t startNs{0}, endNs{0}; };
+struct Snapshot {
+  bool available{false};
+  uint64_t revision{0}, droppedContention{0}, droppedEvents{0};
+  std::array<Metric, Count> metrics{};
+  std::array<Event, 12> events{};
+  size_t eventCount{0};
+};
+class Aggregate {
+ public:
+  void Record(Operation op, uint64_t start, uint64_t end) {
+    if (op >= Count || end < start) return;
+    std::unique_lock<std::mutex> guard(mutex, std::try_to_lock);
+    if (!guard.owns_lock()) { dropped.fetch_add(1, std::memory_order_relaxed); return; }
+    auto& metric = pending.metrics[op];
+    ++metric.count;
+    if (end-start >= metric.maxNs) {
+      metric.maxNs=end-start; metric.maxStartNs=start; metric.maxEndNs=end;
+    }
+    if (end-start > 40000000ULL) {
+      if (pending.eventCount < pending.events.size())
+        pending.events[pending.eventCount++] = Event{op,start,end};
+      else ++pending.droppedEvents;
+    }
+  }
+  Snapshot Take() {
+    std::unique_lock<std::mutex> guard(mutex, std::try_to_lock);
+    if (!guard.owns_lock()) return Snapshot{}; // Preserve pending events for next row.
+    Snapshot out=pending;
+    out.available=true; out.revision=++revision;
+    out.droppedContention=dropped.exchange(0, std::memory_order_relaxed);
+    pending=Snapshot{};
+    return out;
+  }
+ private:
+  std::mutex mutex;
+  std::atomic<uint64_t> dropped{0};
+  uint64_t revision{0};
+  Snapshot pending{};
+};
+class Span {
+ public:
+  Span(Aggregate& aggregate, Operation op, uint64_t (*clock)(), bool enabled)
+      : aggregate(aggregate), op(op), clock(clock), enabled(enabled), start(enabled ? clock() : 0) {}
+  ~Span() { if (enabled) aggregate.Record(op,start,clock()); }
+ private:
+  Aggregate& aggregate;
+  Operation op;
+  uint64_t (*clock)();
+  bool enabled;
+  uint64_t start;
+};
+inline void WriteJson(std::ostream& out, const Snapshot& snapshot) {
+  out << "{\"version\":1,\"threshold_ns\":40000000,\"available\":"
+      << (snapshot.available ? "true" : "false") << ",\"revision\":" << snapshot.revision
+      << ",\"dropped_contention\":" << snapshot.droppedContention
+      << ",\"dropped_events\":" << snapshot.droppedEvents << ",\"operations\":{";
+  for (size_t i=0;i<Count;++i) {
+    const auto& m=snapshot.metrics[i];
+    if (i) out << ',';
+    out << '\"' << Names[i] << "\":{\"count\":" << m.count << ",\"max_ns\":" << m.maxNs
+        << ",\"max_start_mach_ns\":" << m.maxStartNs
+        << ",\"max_end_mach_ns\":" << m.maxEndNs << '}';
+  }
+  out << "},\"long_events\":[";
+  for (size_t i=0;i<snapshot.eventCount;++i) {
+    const auto& e=snapshot.events[i];
+    if (i) out << ',';
+    out << "{\"operation\":\"" << Names[e.operation] << "\",\"start_mach_ns\":"
+        << e.startNs << ",\"end_mach_ns\":" << e.endNs << '}';
+  }
+  out << "]}";
+}
+} // namespace owned_stall
